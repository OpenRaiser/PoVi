        "王安石身着宋代官服",
        "面容忧虑沉思",
        "贬谪或赴任途中的行装"
      ],
      "sound_evidence": [
        "朝堂上的激烈争辩声",
        "沉重的叹息声"
      ],
      "importance": 3
    },
    {
      "event_id": "evt_045_03",
      "description": "王安石秋日登临金陵远望。晚秋时节，王安石在江宁（金陵）登高，俯瞰澄澈如白练的长江、往来的帆船与夕阳西风。登临的具体时间存在多说，通常认为作于其出知江宁府期间（1067年或1076年之后）。",
      "audio_triggers": [
        "登临送目",
        "晚秋",
        "金陵怀古",
        "江宁知府"
      ],
      "visual_evidence": [
        "晚秋时节的金陵城楼",
        "长江如练",
        "群峰翠绿如簇",
        "夕阳余晖",
        "江边酒楼外斜插飘扬的酒旗"
      ],
      "sound_evidence": [
        "猎猎秋风声",
        "江波拍岸声",
        "水鸟飞起的扑腾声"
      ],
      "importance": 2
    },
    {
      "event_id": "evt_045_04",
      "description": "王安石触景生情写成《桂枝香·金陵怀古》。面对六朝故都的秋景，他联想历史悲剧，叹息世人只知空叹兴亡而不图振作改革。借古讽今，他提笔写下了这首意境雄浑的词作，寄托对国家命运的关切。",
      "audio_triggers": [
        "桂枝香",
        "借古讽今",
        "千古凭高",
        "写下这首名篇"
      ],
      "visual_evidence": [
