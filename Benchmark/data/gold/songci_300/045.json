{
  "schema_version": "0.2",
  "sample_id": "songci_300_045",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《桂枝香·金陵怀古》为北宋政治家、文学家王安石所作，体裁为词。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：桂枝香 作者：王安石 朝代：宋 体裁：词",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "王安石（1021—1086），字介甫，号半山，北宋著名政治家、文学家、思想家",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确标注该作为北宋王安石词作",
        "可结合其政治家身份理解词中深沉的历史视野"
      ],
      "forbidden_assertions": [
        "该作品为唐代诗人所作",
        "体裁为律诗或绝句"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "此词约作于王安石任江宁知府或变法受挫退居金陵期间，借六朝兴亡寄托对北宋朝政的忧思。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "此词可能是出知江宁府时所作。公元1067年...第一次任江宁知府...公元1076年之后王安石被罢相，第二次出任江宁知府。",
          "locator": "创作背景一",
          "authority": "medium"
        },
        {
          "source_id": "source_background_2",
          "text": "约作于宋神宗熙宁年间（1068—1077），王安石变法受挫后，退居金陵。目睹六朝古都的盛衰之迹，借古讽今，表达了对国家命运的深切关注。",
          "locator": "创作背景二",
          "authority": "medium"
        },
        {
          "source_id": "source_background_3",
          "text": "宋英宗治平四年（1067年）...第一次任江宁知府...还有一种说法是，此词大约作于王安石第二次被罢相、出知江宁府的时候，时间在宋神宗熙宁九年（1076年）之后。",
          "locator": "创作背景三",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "创作时间与作者两次知江宁府的政治生涯节点高度重合",
        "词中怀古实为讽今，反映作者对北宋现实政治的忧虑"
      ],
      "forbidden_assertions": [
        "作于南宋或明代",
        "纯为游览金陵而作的闲适之词，无政治寄托"
      ]
    },
    {
      "claim_id": "claim_03_imagery",
      "claim": "“千里澄江似练，翠峰如簇”运用明喻，将长江比作白绢，群峰比作箭簇，勾勒金陵秋景的壮阔。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "千里澄江似练：形容长江像一匹长长的白绢。如簇：这里指群峰好像丛聚在一起。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "千里澄江似练：形容长江像一匹长长的白绢。语出谢眺《晚登三山还望京邑》...如簇：这里指群峰好像丛聚在一起。",
          "locator": "注释二",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "千里澄江似练，翠峰如簇。",
          "locator": "l02",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "化用谢朓名句，突出江水澄澈与山势峭拔的视觉张力",
        "白描手法结合比喻，奠定全词雄浑苍凉的基调"
      ],
      "forbidden_assertions": [
        "此处使用借代或暗喻手法",
        "描写的是春季繁花或冬季雪景"
      ]
    },
    {
      "claim_id": "claim_04_allusion",
      "claim": "词中“门外楼头”化用《台城曲》指陈后主亡国惨剧，“商女犹唱《后庭》遗曲”化用杜牧《泊秦淮》，批判六朝荒淫误国并暗讽当世。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "门外楼头：指南朝陈亡国惨剧。门：指朱雀门。楼：指结绮阁。后庭遗曲：指歌曲《玉树后庭花》...最后三句化用杜牧《泊秦淮》诗意。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "门外楼头：指南朝陈亡国惨剧。语出《台城曲》：“门外韩擒虎，楼头张丽华。”...商女不知亡国恨，隔江犹唱《后庭花》，后人认为是亡国之音。",
          "locator": "注释二",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "“门外楼头”，用《台城曲》句加以点染...此处用典。“商女不知亡国恨，隔江犹唱《后庭花》！”此唐贤小杜...词人复加运用，便觉尺幅千里，饶有有余不尽之情致。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "典故高度浓缩历史兴亡教训，具有强烈的现实警示意义",
        "借古音讽今世，体现政治家对时局的清醒认知"
      ],
      "forbidden_assertions": [
        "门外楼头仅指普通城门与楼阁建筑",
        "商女唱曲仅为描写市井娱乐生活，无历史隐喻"
      ]
    },
    {
      "claim_id": "claim_05_structure",
      "claim": "全词上片写景，下片怀古抒情，“念”字为转折枢纽，实现由实入虚、今昔对比的时空转换。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "上阕写登临金陵故都之所见...下阕写在金陵之所想。“念”字作转折，今昔对比，时空交错，虚实相生",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "上片写金陵之景，下片写怀古之情...换头之后写怀古：在金陵建都的六朝帝王，争奇斗胜地穷奢极欲，演出一幕幕触目惊心的亡国悲剧。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "章法严谨，上片铺陈壮丽山河为下片历史反思蓄势",
        "“念”字是理解全词情感脉络与逻辑推进的关键"
      ],
      "forbidden_assertions": [
        "上下片内容割裂无关联",
        "全篇纯写景或纯抒情，无转折过渡"
      ]
    },
    {
      "claim_id": "claim_06_textual_variants",
      "claim": "本词在不同版本中存在异文，如“归帆去棹”在部分版本中作“征帆去棹”，“六朝旧事随流水，但寒烟、芳草凝绿”在版本二中作“但寒烟衰草凝绿”。",
      "status": "disputed",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_original_1",
          "text": "归帆去棹残阳里，背西风，酒旗斜矗。……但寒烟、芳草凝绿。",
          "locator": "原文版本一",
          "authority": "high"
        },
        {
          "source_id": "source_original_2",
          "text": "归帆去棹残阳里……但寒烟衰草凝绿。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "归帆去棹：一作“征帆”……六朝旧事随流水，但寒烟衰草凝绿：意谓六朝的往事像流水般消逝了，如今只有寒烟笼罩衰草，凝成一片暗绿色",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“芳草”与“衰草”在文学意象上分别侧重于绿意常在与荒凉衰败，体现了不同版本在审美取向上的细微差异"
      ],
      "forbidden_assertions": [
        "“归帆去棹”在所有古籍版本中均无任何异文"
      ]
    },
    {
      "claim_id": "claim_07_lexical_qinhuai",
      "claim": "词中“彩舟云淡，星河鹭起”两句转写秦淮河，其中“星河”指秦淮河，“鹭”一说指白鹭洲（长江与秦淮河相汇之处的小洲）。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "这两句转写秦淮河……星河，天河，这里指秦淮河。鹭，白鹭，一种水鸟。一说指白鹭洲（长江与秦淮河相汇之处的小洲）。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "星河，银河，这里指长江。长江中有白鹭洲（在今南京水西门外）。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“星河”在此处并非实指天上的银河，而是借指波光粼粼、华灯映水的江河"
      ],
      "forbidden_assertions": [
        "“星河”在词中仅指天上的银河，与地面的河流无关"
      ]
    }
  ],
