{
  "schema_version": "0.2",
  "sample_id": "songci_300_271",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词为南宋词人王沂孙所作《齐天乐》，属咏物词，以蝉为吟咏对象。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：齐天乐，作者：王沂孙，朝代：宋，体裁：词，词牌：齐天乐",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "王沂孙……工词，风格接近周邦彦……尤以咏物为工，皆善于体会物象以寄托感慨。",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可明确该词为宋代咏物词代表作之一",
        "作者擅长以物象寄托个人感慨"
      ],
      "forbidden_assertions": [
        "该词为唐代或明代作品",
        "作者非王沂孙",
        "该词为山水田园诗而非咏物词"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "词作于宋末元初，作者亲历亡国之变，词中寒蝉哀吟实为寄托亡国之恨与遗民之悲。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "王沂孙生活于宋末元初，切身地经历南宋国之变……《齐天乐·蝉》该词即是在这种情况下写出，以寒蝉的哀吟写亡国之恨。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "元兵入会稽，杨琏真珈掘宋帝六陵，沂孙与唐珏、周密等结吟社，赋《乐府补题》，托意莲、蝉诸物，寄托亡国之恸。",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "词中悲苦情绪与南宋灭亡的历史创伤直接相关",
        "咏蝉是当时遗民词人结社寄托哀思的常见手法"
      ],
      "forbidden_assertions": [
        "该词仅写个人失恋或日常闲愁",
        "创作于北宋太平盛世",
        "词中毫无政治或家国寄托"
      ]
    },
    {
      "claim_id": "claim_03_allusion_gonghun",
      "claim": "“宫魂断”化用齐后化蝉典故，将蝉拟作含恨而亡的宫妃，奠定全词哀怨凄楚的基调。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "宫魂断：用齐后化蝉典。宫魂：即齐后之魂。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_translation_1",
          "text": "宫妃满怀离恨，忿然魂断，化作一只衰蝉，年年都在庭院的绿荫丛中哀呜。",
          "locator": "译文一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "起句即赋予蝉以人格化的历史悲剧色彩",
        "“余恨”指向的是无法消解的故国之思"
      ],
      "forbidden_assertions": [
        "“宫魂”指代唐代宫廷乐师",
        "该典故与蝉的生物学特征无关",
        "起句仅为写景，无情感铺垫"
      ]
    },
    {
      "claim_id": "claim_04_allusion_tongxian",
      "claim": "“铜仙铅泪似洗，叹移盘去远”借用汉武帝金铜仙人辞汉典故，暗喻宋室倾覆、故国难回。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "铜仙：用汉武帝金铜仙人典。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_translation_1",
          "text": "金铜仙人铅泪如洗，去国辞乡，只可叹她携盘远去，不能再贮藏清露以供哀蝉了。",
          "locator": "译文一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "承露盘去远象征故国文物与正统的流失",
        "蝉因无露可饮而更显生存困境，映射遗民失所"
      ],
      "forbidden_assertions": [
        "该句实写汉代宫廷实景",
        "铜仙流泪与蝉的生存毫无关联",
        "典故仅用于装饰辞藻，无现实指涉"
      ]
    },
    {
      "claim_id": "claim_05_metaphor_sound_appearance",
      "claim": "“瑶佩流空，玉筝调柱”以玉声与筝音比喻蝉鸣之清脆；“娇鬓”借魏宫女莫琼树制蝉鬓典故喻蝉翼之美。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "瑶佩：以玉声喻蝉鸣声美妙，下“玉筝”同。镜暗妆残，为谁娇鬓尚如许：……魏文帝宫女莫琼树制蝉鬓，缥缈如蝉。娇鬓：美鬓，借喻蝉翼的美丽。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "听觉与视觉意象交织，突出蝉虽衰而声容犹美",
        "以美衬悲，强化无人欣赏的孤寂感"
      ],
      "forbidden_assertions": [
        "瑶佩、玉筝为实写窗外人物活动",
        "娇鬓指代词人自身容貌",
        "比喻手法在此处不成立"
      ]
    },
    {
      "claim_id": "claim_06_theme_lifecycle",
      "claim": "“病翼惊秋”至“漫想薰风”写秋蝉衰病将死，追忆夏日繁盛，以物之生死荣枯映射人世沧桑与故国之思。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_translation_1",
          "text": "秋蝉病弱的双翼惊恐清秋的到来……她只能徒然追忆当年自己欢笑在薰风中，柳丝万缕飘飞的美景。",
          "locator": "译文一",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "枯形：指蝉蜕。谩想：空想。熏风：南风，此指夏天。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "时间线由秋入夏，以虚景反衬现实之衰飒",
        "“空想”二字点破繁华不可复得的绝望"
      ],
      "forbidden_assertions": [
        "该段纯为自然物候记录，无情感投射",
        "薰风与柳丝代表词人当下的真实处境",
        "蝉的生命周期与朝代兴衰无关"
      ]
    },
    {
      "claim_id": "claim_07_textual_variants",
      "claim": "传世版本存在“余/馀”、“移/携”、“清商/清高”、“谩/漫”等异文，但不影响核心意象与主旨。",
      "status": "documented",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_original_2",
          "text": "一襟馀恨宫魂断……叹携盘去远……甚独抱清高……谩想薰风",
          "locator": "原文版本二",
          "authority": "medium"
        },
        {
          "source_id": "source_original_3",
          "text": "馀音更苦……谩想熏风",
          "locator": "原文版本三",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "异文属古籍传抄常见现象，教学时可择善而从或并注",
        "核心词义与情感指向在诸版本中保持一致"
      ],
      "forbidden_assertions": [
        "异文导致全词主旨发生根本改变",
        "必须认定某一版本为绝对唯一正体",
        "版本差异证明作者未定稿"
      ]
    },
    {
      "claim_id": "claim_08_lexical_details",
      "claim": "词中“一襟”意为满腔，“凉柯”指秋天的树枝，“暗叶”指浓暗的树叶，“枯形”指蝉蜕，“消得”意为经受得住，“甚”意为正，“清商”指清商曲，为古乐府之一种，曲调凄楚，“谩想”指空想，“熏风”指南风，此指夏天。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "一襟：满腔。凉柯：秋天的树枝。暗叶：浓暗的树叶。枯形：指蝉蜕。消得：经受的住。甚：正。清商：清商曲，古乐府之一种，曲调凄楚。谩想：空想。熏风：南风，此指夏天。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "词人通过一系列极具秋意与悲凉色彩的词汇，层层铺垫寒蝉的悲剧命运",
        "“谩想”与“熏风”的对比，加深了现实与往昔、秋凉与夏暖的落差"
      ],
      "forbidden_assertions": [
        "凉柯指春天的嫩芽",
        "枯形指枯萎的树枝",
        "熏风指冬天的寒风"
      ]
    }
  ],
