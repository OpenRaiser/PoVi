        "悲凉的风声"
      ],
      "importance": 3
    },
    {
      "event_id": "evt_271_02",
      "description": "元军占领会稽后，元朝江南释教总统杨琏真珈带人肆意盗掘南宋宋帝六陵，此事极大刺激了江南的南宋遗民。",
      "audio_triggers": [
        "元兵入会稽",
        "杨琏真珈",
        "宋帝六陵"
      ],
      "visual_evidence": [
        "元军士兵与异族僧侣破坏皇家陵寝",
        "掘开坟墓的惨烈景象"
      ],
      "sound_evidence": [
        "沉重的挖掘声",
        "墓石、器物被破坏的碎裂声"
      ],
      "importance": 3
    },
    {
      "event_id": "evt_271_03",
      "description": "出于对国家败亡和皇陵被毁的悲愤，王沂孙与唐珏、周密等人秘密结为吟社，共同赋写《乐府补题》，以咏物词隐晦地寄托亡国之恸。",
      "audio_triggers": [
        "结吟社",
        "赋《乐府补题》",
        "咏物寄托"
      ],
      "visual_evidence": [
        "几位宋末文人在隐蔽的室内或山林中集会",
        "展卷挥毫，面容沉痛悲郁"
      ],
      "sound_evidence": [
        "沉重无奈的叹息声",
        "毛笔在纸上书写的沙沙声"
      ],
      "importance": 3
    },
    {
      "event_id": "evt_271_04",
      "description": "通常认为在此种故国沦亡的背景下，王沂孙创作了《齐天乐》一词。他借寒秋中哀鸣的衰蝉与金铜仙人辞汉的典故，幽曲地倾诉了遗民的故国之思与凄楚处境。",
      "audio_triggers": [
        "齐天乐",
        "寒蝉哀吟",
        "金铜仙人"
      ],
      "visual_evidence": [
        "秋日西窗之下，王沂孙在书案前写词",
        "窗外秋雨初歇，树木枝干凄清，树叶浓暗凋零"
      ],
      "sound_evidence": [
        "秋风扫过树叶的沙沙声",
        "微弱凄切的秋蝉哀鸣声"
      ],
      "importance": 3
    }
  ],
