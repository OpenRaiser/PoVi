  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《戚氏》为北宋词人柳永所创制的长调慢词，全词三叠共212字，被誉为柳词压轴之作。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "戚氏",
          "locator": "cipai",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "戚氏：词牌名，为柳永所创，长调慢词，《乐章集》收入“中吕调”。全词三叠，计212字，为北宋长调慢词之最，亦堪称柳词压轴之作。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "柳永（约984—1053）……开创“慢词”长调体裁",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学中可强调该词牌为柳永自创",
        "可指出该词在宋词长调发展中的重要体制地位"
      ],
      "forbidden_assertions": [
        "该词牌为前人已有旧曲",
        "全词字数非212字或结构非三叠",
        "作者为苏轼或其他宋代词人"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "此词约作于柳永晚年外放荆南（湖北江陵）期间，时年过五十，仅任县令级小官，仕途失意与羁旅愁思交织。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "从词中“宋玉悲感，向此临水与登山”来看，这首词当写于湖北江陵，当时柳永外放荆南，已经年过五十，只做个相当于县令的小官，心情自然十分苦闷。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "当时柳永外放荆南，已经年过五十，只做个相当于县令的小官，心情自然十分苦闷。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "词中悲秋与羁旅情绪与其晚年贬谪境遇直接相关",
        "可结合宋玉悲秋典故理解其不遇之叹"
      ],
      "forbidden_assertions": [
        "作于柳永少年游历时期",
        "作于其高中进士的得意之时",
        "创作地点在汴京而非江陵"
      ]
    },
    {
      "claim_id": "claim_03_structure",
      "claim": "全词分三叠，按时间顺序由傍晚至深夜再到拂晓，空间由近处庭轩推至远方江关，情感由写景转入忆旧与自伤。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "全词共分三片：头一片，写作者白天的所见所闻第二片写情，写作者“更阑”的所见所感第三片写意，写作者对往事的追忆，抒发自己的感慨。",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "由傍晚到深夜、由深夜至黎明一丝不乱；由眼前望江关、由孤馆怀帝京自然运转。",
          "locator": "赏析一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学可引导学生按时间线索梳理词意",
        "三叠分别侧重写景、抒情、议论/忆旧"
      ],
      "forbidden_assertions": [
        "全词为单片结构",
        "时间顺序为倒叙或跳跃无序",
        "下片主要描写未来愿景"
      ]
    },
    {
      "claim_id": "claim_04_metaphor_time",
      "claim": "词中以“迅景如梭”“漏箭移”等意象比喻光阴飞逝，以“旧游似梦”喻指往昔繁华的虚幻与不可追。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "迅景：岁月也，光阴易逝，故称。漏箭：古时以漏壶滴水计时，漏箭移即光阴动也。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "很通俗的比喻，却让读者眼前出现了词人那再清晰不过的痛苦面容。逝去的日子如云烟……",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可指出柳永善用日常器物与天文现象喻指时间流逝",
        "比喻强化了人生短暂与功名未就的焦虑"
      ],
      "forbidden_assertions": [
        "漏箭指代具体的兵器",
        "迅景指快速移动 of 自然景色而非时间",
        "旧游似梦表示梦境成真"
      ]
    },
    {
      "claim_id": "claim_05_theme",
      "claim": "词作核心矛盾在于“念利名、憔悴长萦绊”的仕途追求与“未名未禄，绮陌红楼”的市井流连之间的挣扎，最终以“抱影无眠”的孤寂作结。",
      "status": "licensed_interpretation",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "一面痛恨“名牵利惹”，一面甘之如饴。行文至此，那贯穿于词人一生的矛盾开始在这“驱驱行役”上初露端倪。",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "念利名、憔悴长萦绊……停灯向晓，抱影无眠。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可探讨宋代文人仕隐矛盾与市井文化的冲突",
        "结尾的无眠是矛盾无法排解的具象化"
      ],
      "forbidden_assertions": [
        "词人完全看破红尘放弃名利",
        "词作主旨为单纯赞美京城繁华",
        "抱影无眠表示期待天明出游"
      ]
    },
    {
      "claim_id": "claim_06_lexical_jingwu",
      "claim": "“井梧”指井旁的梧桐，其典故源自唐代薛涛的《井梧吟》：“庭除一古桐，耸干入云中。枝迎南北鸟，叶送往来风。”",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "井梧：井旁挺拔的梧桐古树。源自唐薛涛《井梧吟》：\"庭除一古桐,耸干入云中。枝迎南北鸟，叶送往来风。\"",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "词中借井梧零乱的景象，不仅写秋景之凋零，也暗寓羁旅漂泊、送往迎来的身世之感"
      ],
      "forbidden_assertions": [
        "井梧是指水井中生长的植物",
        "井梧典故出自宋代苏轼的诗作"
      ]
    },
    {
      "claim_id": "claim_07_lexical_longshui",
      "claim": "“陇水”在词中疑非指具体的河流名，而是借用北朝乐府《陇头歌辞》中“陇头流水，鸣声呜咽”的意境，表达行人的飘然旷野与思乡哀痛。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "陇水：疑非河流名，实为陇头流水之意。北朝乐府有《陇头歌辞》……",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "倦听陇水潺湲，是词人将主观的厌倦与愁苦投射于客观水声的艺术表现"
      ],
      "forbidden_assertions": [
        "陇水在词中确指湖北江陵当地的一条具体河流",
        "陇水潺湲在词中是欢快悦耳的象征"
      ]
    },
    {
      "claim_id": "claim_08_allusion_songyu",
      "claim": "“宋玉悲感”典出战国楚宋玉作《九辩》，其以悲秋起兴，抒发孤身逆旅之寂寞与生不逢时之感，词人借此自况。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "宋玉悲感：战国·楚宋玉作《九辩》，曾以悲秋起兴，抒孤身逆旅之寂寞，发生不逢时之感慨。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "词人临水登山，在空间上与宋玉悲秋的楚地（江陵）重合，强化了跨越千年的情感共鸣"
      ],
      "forbidden_assertions": [
        "宋玉悲感是指宋玉因国家灭亡而绝食",
        "宋玉是唐代的著名悲情诗人"
      ]
    },
    {
      "claim_id": "claim_09_lexical_jiangguan",
      "claim": "“江关”在词中疑指荆门，即今湖北省枝城市和宜昌市夹江对峙的荆门、虎牙二山，战国时为楚地。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "江关：疑即指荆门，荆门、虎牙二山（分别在今湖北省枝城市和宜昌市）夹江对峙，古称江关，战国时为楚地。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“望江关”的动作体现了词人登高远眺、心系远方的羁旅情怀"
      ],
      "forbidden_assertions": [
        "江关在词中确指长江三峡的夔门",
        "江关是指京城的城门"
      ]
    },
    {
      "claim_id": "claim_10_reception_history",
      "claim": "宋代评论界对《戚氏》评价极高，王灼在《碧鸡漫志》中曾引宋人语评价其为“《离骚》寂寞千载后，《戚氏》凄凉一曲终”，认为其可与《离骚》媲美。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "宋时“《离骚》寂寞千年后，《戚氏》凄凉一曲终”的评价也必非空穴来风。",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "宋《碧鸡漫志》：“离骚寂寞千载后，戚氏凄凉一曲终。”宋人的评价，让这首冠古绝今之词当之无愧！王灼",
          "locator": "赏析一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
