{
  "schema_version": "0.2",
  "sample_id": "songci_300_063",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本作为北宋苏轼所作《水调歌头》，属词体，词牌为水调歌头。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：水调歌头 作者：苏轼 朝代：宋 体裁：词 词牌：水调歌头",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "苏轼（1037—1101）……北宋著名文学家……其词豪放洒脱，开宋词豪放派先河，代表作有《念奴娇·赤壁怀古》《水调歌头·明月几时有》等。",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可明确该作品为宋代豪放词代表作之一",
        "作者苏轼为北宋文坛核心人物"
      ],
      "forbidden_assertions": [
        "该作品为唐代诗歌",
        "作者为辛弃疾或其他宋代词人"
      ]
    },
    {
      "claim_id": "claim_02_context",
      "claim": "词作于宋神宗熙宁九年（1076年）中秋密州任上，因与弟苏辙七年未聚，借醉后赏月抒发思念。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_original_3",
          "text": "丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由。",
          "locator": "原文版本三",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "这首词是公元1076年（宋神宗熙宁九年）中秋作者在密州时所作……词人与胞弟苏辙分别之后，已七年未得团聚。",
          "locator": "创作背景一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "创作动机包含兄弟离别之思与政治外放的背景",
        "小序是理解全词情感基调的关键线索"
      ],
      "forbidden_assertions": [
        "该词作于黄州贬谪期间",
        "创作背景与兄弟团聚无关"
      ]
    },
    {
      "claim_id": "claim_03_lexical",
      "claim": "“琼楼玉宇”指想象中的月宫；“婵娟”本指姿态美好，此处借指明月。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "琼楼玉宇：美玉砌成的楼宇，指想象中的月宫。……婵娟：本意指妇女姿态美好的样子，这里形容月亮。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中需明确“婵娟”在此处的借代用法",
        "“琼楼玉宇”具有神话色彩与理想化特征"
      ],
      "forbidden_assertions": [
        "“婵娟”指代嫦娥或仙女",
        "“琼楼玉宇”指代人间皇宫"
      ]
    },
    {
      "claim_id": "claim_04_literal",
      "claim": "全词上片写把酒问天、幻想乘风归去又恐高处寒冷，下片写月移照人、由月相盈亏推及人生聚散，终以美好祝愿收束。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_translation_2",
          "text": "我想凭借着风力回到天上去看一看，又担心美玉砌成的楼宇，太高了我经受不住寒冷。……人有悲欢离合的变迁，月有阴晴圆缺的转换，这事儿自古以来就很难周全。希望人们可以长长久久地在一起……",
          "locator": "译文二",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "这首词是中秋望月怀人之作……词人运用形象描绘手法，勾勒出一种皓月当空、亲人千里、孤高旷远的境界氛围。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "上下片存在由“天上幻想”向“人间现实”的转折",
        "情感脉络从迷惘、矛盾走向释然与旷达"
      ],
      "forbidden_assertions": [
        "全词仅停留在写景层面",
        "上下片情感基调完全一致无转折"
      ]
    },
    {
      "claim_id": "claim_05_philosophy",
      "claim": "词人借自然规律（月之圆缺）宽慰人事缺憾（悲欢离合），体现儒释道思想交融下的超然豁达。",
      "status": "licensed_interpretation",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "苏轼一生，推崇儒学、讲究实务为主。但他也“龆龀好道”，中年以后，又曾表示过“归依佛僧”，经常处在儒释道的纠葛当中的。每当挫折失意之际，则老庄思想上升，借以帮助自己解释穷通进退的困惑。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "poem",
          "text": "人有悲欢离合，月有阴晴圆缺，此事古难全。",
          "locator": "l07",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“此事古难全”是对人生常态的理性接纳",
        "词作展现了宋代士大夫在困境中的精神自救"
      ],
      "forbidden_assertions": [
        "词人主张消极避世或彻底放弃现实",
        "该哲理仅受单一思想流派影响"
      ]
    },
    {
      "claim_id": "claim_06_version",
      "claim": "传世文本在第三句虚词上存在“惟恐”与“又恐”的异文，但不改变词意与情感逻辑。",
      "status": "documented",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_original_1",
          "text": "我欲乘风归去，惟恐琼楼玉宇，高处不胜寒。",
          "locator": "原文版本一",
          "authority": "high"
        },
        {
          "source_id": "source_original_2",
          "text": "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。",
          "locator": "原文版本二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学时可说明版本差异属古籍流传常见现象",
        "两词皆表达犹豫与顾虑，核心语义一致"
      ],
      "forbidden_assertions": [
        "某一版本为绝对错误",
        "虚词差异导致全词主旨改变"
      ]
    },
    {
      "claim_id": "claim_07_lexical_detail",
      "claim": "词中“把酒”意为端起酒杯；“不胜”意为经不住、承受不了；“弄清影”指诗人在月光下起舞，影子也随之舞动。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "把酒：端起酒杯。把：执、持。……不胜：经不住，承受不了。胜：承担、承受。……弄清影：意思是诗人在月光下起舞，影子也随着舞动。弄：玩弄，欣赏。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“把”字在此处作动词，意为执、持",
        "“弄”字带有欣赏、玩味的主观色彩"
      ],
      "forbidden_assertions": [
        "“不胜”在此处表示非常、十分",
        "“把酒”是指把酒洒在地上祭祀"
      ]
    },
    {
      "claim_id": "claim_08_disputed_hesi",
      "claim": "词中“何似”一词的释义存在分歧，一说为“何如，哪里比得上”；另一说为“何时”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "何似：何如，哪里比得上。一说何时。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "若译为“哪里比得上”，则强调人间生活优于天上仙境",
        "若译为“何时”，则改变了句意逻辑，教学中应予以说明"
      ],
      "forbidden_assertions": [
        "“何似”在学术界仅有唯一确凿的解释"
      ]
    },
    {
      "claim_id": "claim_09_reception",
      "claim": "此词艺术成就极高，清代先著《词洁》评其为“天仙化人之笔”，现代更被谱曲传唱，并由杨利伟在太空朗诵，成为中华文化传播的标志。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_2",
          "text": "作为中国词史上传播最广的作品，其\"婵娟\"意象被谱成《但愿人长久》传唱全球，清代先著《词洁》评：\"此词自是天仙化人之笔，凡俗岂能梦见？\"2003年杨利伟太空朗诵此词，成为中华文化宇宙传播的标志。",
          "locator": "创作背景二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "该词在古代与现代均享有极高的文学与社会声誉",
        "“婵娟”意象已成为华人世界共同的文化符号"
      ],
      "forbidden_assertions": [
        "该词在清代并未受到重视",
        "该词的现代传播仅局限于学术界"
      ]
    }
  ],
