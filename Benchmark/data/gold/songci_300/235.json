  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "作品为南宋词人吴文英所作，词牌为《莺啼序》，又名“春晚感怀”或“感怀”，全词共二百四十字，是词调中最长的一种。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：莺啼序 作者：吴文英 朝代：宋 体裁：词 词牌：莺啼序",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "吴文英（1200—1268），南宋词人，字君特，号梦窗，浙江宁波人。",
          "locator": "作者简介一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "一共四片240字，是最长的词调。这首词在《宋六十名家词》中又题作 ‘春晚感怀’、‘感怀’",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确指出该词为宋代长调慢词的代表作",
        "可提及作者别号“梦窗”及其在词史上的地位"
      ],
      "forbidden_assertions": [
        "该词为唐代或明代作品",
        "词牌名或作者姓名张冠李戴",
        "声称该词篇幅短小或为小令"
      ]
    },
    {
      "claim_id": "claim_02_theme_structure",
      "claim": "全词分为四段（四片），结构大开大阖、时空交错，融伤春、怀旧与悼亡于一体，核心主旨为悼念杭州亡妾。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "全词分为四段，长达二百四十字...集中而形象地表现了伤春惜别之情，在结构上体现出时空交错的特点。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "本词抒写春晚感怀，融伤春、怀旧、悼亡于一体...这是吴文英为悼念亡妾而做的一首词",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_background_1",
          "text": "这首《莺啼序·残寒正欺病酒》 当作于宝祐（宋理宗年号，1253—1258）初年，为作者悼念亡妾之作。",
          "locator": "创作背景一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可指出四片分别对应现实伤春、西湖旧游、重访悼亡、长恨相思的叙事脉络",
        "可强调该词虽涉个人情事，但情感真挚，非寻常艳词可比"
      ],
      "forbidden_assertions": [
        "该词主旨为纯粹的政治讽喻或边塞征战",
        "全词仅写伤春而无悼亡之意",
        "结构为单线平铺直叙无时空跳跃"
      ]
    },
    {
      "claim_id": "claim_03_metaphor_catkins",
      "claim": "词中“念羁情、游荡随风，化为轻絮”将漂泊的羁旅愁思与伤春之情，比喻为随风飘荡的柳絮。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "poem",
          "text": "念羁情、游荡随风，化为轻絮。",
          "locator": "l04",
          "authority": "high"
        },
        {
          "source_id": "source_translation_1",
          "text": "我的心中有千万缕羁思旅情，恰似随风游荡，化作了柳絮轻扬飘浮。",
          "locator": "译文一",
          "authority": "low"
        },
        {
          "source_id": "source_notes_1",
          "text": "羁情：离情。一说指情思随风飘荡。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "柳絮意象强化了词人客居他乡、无所依托的漂泊感",
        "此句起到承上启下作用，由眼前暮春之景自然过渡至下片回忆"
      ],
      "forbidden_assertions": [
        "轻絮指代具体的某位女子",
        "羁情仅指对朝廷的忠君之思"
      ]
    },
    {
      "claim_id": "claim_04_metaphor_herbs_time",
      "claim": "“幽兰旋老，杜若还生”以香草的荣枯更替，象征时光流逝、人事代谢，反衬词人长期羁旅水乡的孤寂。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "poem",
          "text": "幽兰旋老，杜若还生，水乡尚寄旅。",
          "locator": "l09",
          "authority": "high"
        },
        {
          "source_id": "source_translation_2",
          "text": "幽兰转眼间就已老去，汀洲上新生的杜若散着香气，岁月匆匆流逝，我依旧在水乡漂泊羁旅。",
          "locator": "译文二",
          "authority": "low"
        },
        {
          "source_id": "source_notes_1",
          "text": "幽兰：幽香的兰花。旋：不久。杜若：生长在水边的一种香草...",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "香草意象继承楚辞传统，暗含对美好事物消逝的痛惜",
        "自然物候的循环与人事的不可逆形成张力，深化羁旅之悲"
      ],
      "forbidden_assertions": [
        "幽兰与杜若仅作为植物学名词出现，无象征意义",
        "该句表达的是对农业丰收的喜悦"
      ]
    },
    {
      "claim_id": "claim_05_metaphor_objects_grief",
      "claim": "“亸凤迷归，破鸾慵舞”借垂翅孤凤与破镜孤鸾的意象，隐喻词人丧偶后的失意迷惘与无心欢娱的哀痛。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "poem",
          "text": "亸凤迷归，破鸾慵舞。",
          "locator": "l14",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "亸凤：垂翅之凤，喻失意之意。一说凤指凤钗。破鸾：失去伴侣的鸾鸟。一说鸾指鸾镜。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_translation_3",
          "text": "我就像垂下翅膀的孤凤忘记了归路，又像孤苦无依的孤鸾懒得飞翔起舞一样。",
          "locator": "译文三",
          "authority": "low"
        }
      ],
      "acceptable_inferences": [
        "凤鸾成双的传统文化符号被打破，直接映射伴侣亡故后的形单影只",
        "可结合“暗点检”动作，理解为睹物思人、触物伤情的心理外化"
      ],
      "forbidden_assertions": [
        "凤鸾指代朝廷官员或政治盟友",
        "该句描写的是节日庆典中的舞蹈表演"
      ]
    },
    {
      "claim_id": "claim_06_lexical_allusions",
      "claim": "词中多处使用典故：“仙溪”暗用汉刘晨、阮肇遇仙的故事，指女子所住的地方；“锦儿”用钱塘名妓杨爱爱侍婢的典故代指侍女；“桃根渡”用东晋王献之迎送爱妾桃叶的典故，指代与情人相会之处。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "poem",
          "text": "溯红渐招入仙溪，锦儿偷寄幽素。...记当时、短楫桃根渡",
          "locator": "l06",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "记当时、短楫桃根渡",
          "locator": "l11",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "仙溪：指女子所住的地方。此暗用汉刘晨、阮肇遇仙的故事。锦儿：据宋洪遂《侍儿小名录》载，锦儿是钱塘名妓杨爱爱的侍婢，此处用为侍女的代称。桃根渡：渡口名，即桃叶渡...传说东晋王献之有爱妾名桃叶...此指自己与情人相会之处。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "典故的使用增强了词作的典雅感与抒情的含蓄性",
        "“仙溪”与“桃根渡”均暗示了词人与情人之间如仙境般美好却短暂的遇合"
      ],
      "forbidden_assertions": [
        "锦儿是词人真实的侍女名字",
        "桃根渡是指词人与情人在南京的真实分别地点"
      ]
    },
    {
      "claim_id": "claim_07_disputed_readings",
      "claim": "词中多处字词存在异解或争议：“冉冉”可解为柔媚美好或徐徐上升；“羁情”可解为离情或情思随风飘荡；“亸凤”一说指垂翅之凤（喻失意），一说指凤钗；“破鸾”一说指失伴鸾鸟，一说指鸾镜；“辽海”一说指辽河流域以东至海地区，一说泛指大海。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "冉冉：柔媚美好貌。一解为徐徐上升貌。羁情：离情。一说指情思随风飘荡。亸凤：垂翅之凤，喻失意之意。一说凤指凤钗。破鸾：失去伴侣的鸾鸟。一说鸾指鸾镜。辽海：辽阔的海面。一说辽河流域以东至海地区。此泛指大海。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "这些异解反映了吴文英词作“深曲密丽、讲究字面”的艺术特色，给读者留下了多义的审美空间",
        "无论是实物（凤钗、鸾镜）还是象征（孤凤、孤鸾），其传达的丧偶悲情在本质上是一致的"
      ],
      "forbidden_assertions": [
        "“亸凤破鸾”只有一种标准解释，其他解释均为错误",
        "“辽海”在此处特指具体的地理政治边界"
      ]
    },
    {
      "claim_id": "claim_08_lexical_grief",
      "claim": "词中“断红”指和着胭脂的泪水；“瘗玉埋香”指伊人亡故；“鬓侵半苎”以白色苎麻纤维喻指头发半白；“离痕欢唾”中“痕”指泪痕，“欢唾”指欢闹时向情人吐的口水，合喻过去的悲欢情事。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "poem",
          "text": "断红湿、歌纨金缕。...瘗玉埋香，几番风雨。...叹鬓侵半苎。...离痕欢唾，尚染鲛绡",
          "locator": "l07",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "瘗玉埋香，几番风雨。",
          "locator": "l10",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "叹鬓侵半苎。",
          "locator": "l13",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "离痕欢唾，尚染鲛绡",
          "locator": "l14",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "断红：指和着胭脂的泪水。瘗玉埋香：指伊人亡故。鬓侵半苎：头发半白。苎：苎麻，纤维白色，此喻指白发。离痕欢唾：喻指过去的悲欢情事。痕：泪痕。欢唾：欢闹时向情人吐的口水。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“离痕欢唾”极具生活细节感，表现了词人与亡妾生前亲昵、欢洽的恩爱生活",
        "“鬓侵半苎”形象地展现了词人因极度悲伤和岁月流逝而迅速衰老的外貌特征"
      ],
      "forbidden_assertions": [
        "“断红”指红色的花瓣被折断",
        "“欢唾”指对情人的厌恶或唾弃"
      ]
    },
    {
      "claim_id": "claim_09_creation_background",
      "claim": "《莺啼序》词调实为吴文英首创。此词当作于宝祐初年（1253—1258），当时作者应当不在杭州，可能是在苏州，因春暮而愁，回想往事而作。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "《莺啼序》词调始见于《梦窗词》集及赵闻礼《阳春白雪》所载徐宝之词，实为吴文英之首创。这首《莺啼序·残寒正欺病酒》 当作于宝祐（宋理宗年号，1253—1258）初年...创作此词的时候，作者应当不在杭州，可能是在苏州，因春暮而愁，于是回想往事，感怀发兴。",
          "locator": "创作背景一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "词人身在苏州，却魂牵梦绕于杭州的亡妾，这种空间上的阻隔加深了词作的羁旅之悲",
        "作为词调的首创者，吴文英在此词中展现了极高的驾驭长调慢词的艺术功力"
      ],
      "forbidden_assertions": [
        "该词是吴文英在杭州西湖现场即兴创作的",
        "《莺啼序》词调在唐代就已经非常流行"
      ]
    }
  ],
