{
  "schema_version": "0.2",
  "sample_id": "songci_300_071",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词题为《江神子・江城子》，作者为北宋文学家苏轼，体裁为词。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：江神子・江城子\n作者：苏轼\n朝代：宋\n体裁：词",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "苏轼（1037—1101）...北宋著名文学家、书画家、政治家...其词豪放洒脱，开宋词豪放派先河",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确该作为北宋苏轼的悼亡词代表作",
        "可指出苏轼在词体发展上的豪放派开创地位"
      ],
      "forbidden_assertions": [
        "作者为唐代或明代诗人",
        "该作品体裁为诗或曲"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "此词作于宋神宗熙宁八年（1075年）正月二十日，苏轼时任密州知州，因梦见亡妻王弗（逝世十年）而作。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "这首悼亡词，是宋神宗熙宁八年（1075）徙知山东密州（今山东诸城）时所作...这一年正月二十日，他梦见爱妻王氏，便写下了这首传诵千古的悼亡词。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "十年：指结发妻子王弗去世已十年。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "词中“十年”指王弗卒于1065年，至1075年作词恰满十年",
        "创作动机为正月二十日夜梦亡妻后的情感宣泄"
      ],
      "forbidden_assertions": [
        "王弗逝世于作词当年",
        "此词作于苏轼贬谪黄州时期"
      ]
    },
    {
      "claim_id": "claim_03_structure_theme",
      "claim": "全词上片抒写生死相隔的清醒之痛与漂泊沧桑，下片前五句记梦境重逢，末三句落回现实想象，整体采用虚实结合手法。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "这首词是“记梦”，而且明确写了做梦的日子。但虽说是“记梦”，其实只有下片五句是记梦境，其他都是抒胸臆。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "这首词运用分合顿挫，虚实结合以及叙述白描等多种艺术的表现方法，来表达作者怀念亡妻的思想感情",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "上片侧重现实抒情，下片侧重梦境叙事与想象",
        "记梦仅占下片部分，其余为醒后悲怀"
      ],
      "forbidden_assertions": [
        "全词均为梦境记录",
        "上片描写梦境，下片描写现实"
      ]
    },
    {
      "claim_id": "claim_04_line03_metaphor",
      "claim": "“尘满面、鬓如霜”以风尘与白霜为喻，具象化作者十年间仕途坎坷、生活困顿与容颜衰老。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "尘满面，鬓如霜：形容饱经沧桑，面容憔悴。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_background_2",
          "text": "词中“尘满面，鬓如霜”不仅是对亡妻的哀思，也暗含了自身漂泊沧桑的感慨。",
          "locator": "创作背景二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "该句不仅写生理衰老，更折射政治失意与人生艰辛",
        "比喻使抽象的沧桑感获得强烈的视觉冲击"
      ],
      "forbidden_assertions": [
        "仅指自然气候导致的寒冷与灰尘",
        "与作者个人仕途经历无关"
      ]
    },
    {
      "claim_id": "claim_05_line06_symbolism",
      "claim": "“明月夜、短松冈”以清冷月色与孤松山冈象征亡妻长眠之地，外化作者绵延不绝的哀思与孤寂。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "短松冈：苏轼葬妻之地，短松：矮松。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "特别是“明月夜，短松冈”二句，凄凉清幽独，黯然魂销。...作者设想死者的痛苦，以寓自己的悼念之情。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "景物描写承载了生死两隔的永恒悲痛",
        "推己及人，借亡妻视角反衬自身思念之深"
      ],
      "forbidden_assertions": [
        "仅为客观地理环境描写，无情感寄托",
        "短松冈指代作者故乡而非墓地"
      ]
    },
    {
      "claim_id": "claim_06_emotional_core",
      "claim": "“不思量，自难忘”通过矛盾心态的张力，揭示出深埋心底、无法刻意控制却自然涌现的患难深情。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "作者将“不思量”与“自难忘”并举，利用这两组看似矛盾的心态之间的张力，真实而深刻地揭示自己内心的情感。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_translation_1",
          "text": "强忍不去思念可终究难以忘怀。",
          "locator": "译文一",
          "authority": "low"
        }
      ],
      "acceptable_inferences": [
        "情感表达克制而深沉，非嚎啕大哭式的宣泄",
        "十年岁月未能冲淡感情，反而沉淀为潜意识本能"
      ],
      "forbidden_assertions": [
        "作者已完全放下对亡妻的思念",
        "“不思量”指感情淡漠或遗忘"
      ]
    },
    {
      "claim_id": "claim_07_lexical_details",
      "claim": "词中“思量”意为想念；“千里”指王弗葬地四川眉山与苏轼任所山东密州相隔遥远；“幽梦”指梦境隐约；“小轩窗”指有窗槛的小屋窗前；“顾”指看；“料得”指料想。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "思量：想念。千里：王弗葬地四川眉山与苏轼任所山东密州，相隔遥远，故称“千里”。幽梦：梦境隐约，故云幽梦。小轩窗：指小室的窗前。小轩：有窗槛的小屋。顾：看。料得：料想，想来。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“千里”并非虚指，而是有具体的地理对应（四川眉山至山东密州）",
        "“幽梦”的“幽”字传达出梦境的迷离与凄清感"
      ],
      "forbidden_assertions": [
        "“千里”仅为文学夸张，无实际地理背景",
        "“顾”在词中意为照顾或顾忌"
      ]
    },
    {
      "claim_id": "claim_08_alternative_reading",
      "claim": "词中“料得年年肠断处”在不同版本中存在异文，原文版本二作“料得年年断肠处”，注释一也指出“肠断处”一作“断肠处”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_version_2",
          "text": "料得年年断肠处，明月夜，短松冈。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "肠断处：一作“断肠处”。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“肠断”与“断肠”词义相通，皆形容极度悲伤，不影响词作核心情感的表达"
      ],
      "forbidden_assertions": [
        "“肠断处”与“断肠处”在词意上有根本性的对立"
      ]
    },
    {
      "claim_id": "claim_09_historical_context_detail",
      "claim": "苏轼十九岁时与十六岁的王弗结婚，王弗二十七岁时卒于京师，后葬于眉之东北彭山县安镇乡可龙里先君、先夫人墓之西北八步。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_3",
          "text": "苏东坡十九岁时，与年方十六的王弗结婚...王弗二十七岁就去世了...在《亡妻王氏墓志铭》里说：‘治平二年（1065）五月丁亥，赵郡苏轼之妻王氏（名弗），卒于京师。...葬于眉之东北彭山县安镇乡可龙里先君、先夫人墓之西北八步。’",
          "locator": "创作背景三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "王弗的早逝对苏轼是极大的精神打击",
        "王弗归葬于苏轼父母墓旁，体现了其“侍亲甚孝”的家庭地位"
      ],
      "forbidden_assertions": [
        "王弗去世时年过四十",
        "王弗葬于山东密州"
      ]
    },
    {
      "claim_id": "claim_10_genre_innovation",
      "claim": "在苏轼之前，悼亡诗已有悠久传统（如潘岳、元稹、李商隐等），但用“词”这一体裁来写悼亡，是苏轼的首创。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "从悼亡诗出现一直到北宋的苏轼这期间，悼亡诗写得最有名的有西晋的潘岳和中唐的元稹。晚唐的李商隐亦曾有悼亡之作。...而用词写悼亡，是苏轼的首创。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "苏轼此词拓宽了词的题材边界，使词不再局限于传统的艳情闺怨",
        "此词在悼亡文学史上具有开创性的里程碑意义"
      ],
      "forbidden_assertions": [
        "在苏轼之前，潘岳和元稹已经用词写过悼亡作",
        "苏轼此词完全模仿前人，毫无体裁创新"
      ]
    }
  ],
