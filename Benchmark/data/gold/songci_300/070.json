{
  "schema_version": "0.2",
  "sample_id": "songci_300_070",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "作品为北宋苏轼所作《定风波》，属宋词豪放派代表作。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "定风波 苏轼 宋",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "苏轼（1037—1101）...北宋著名文学家...其词豪放洒脱，开宋词豪放派先河",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确该词为北宋豪放派词人苏轼的代表作之一。"
      ],
      "forbidden_assertions": [
        "该词为唐代诗人所作",
        "该词属于婉约派风格"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "词作于宋神宗元丰五年（1082年）春，苏轼谪居黄州期间，于沙湖道中遇雨有感而发。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_2",
          "text": "此词作于元丰五年（1082年）苏轼谪居黄州时，时年47岁的诗人于沙湖（今湖北黄冈东）买田途中遇雨。",
          "locator": "创作背景二",
          "authority": "high"
        },
        {
          "source_id": "source_original_3",
          "text": "三月七日，沙湖道中遇雨。雨具先去，同行皆狼狈，余独不觉，已而遂晴，故作此词。",
          "locator": "原文版本三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可结合苏轼‘乌台诗案’后贬谪黄州的处境，理解词中旷达之情的现实根基。"
      ],
      "forbidden_assertions": [
        "该词作于苏轼仕途顺遂的京城时期",
        "创作动机是赞美歌女柔奴（注：此为另一首同名《定风波》内容，与本词无关）"
      ]
    },
    {
      "claim_id": "claim_03_literal_action",
      "claim": "词人面对穿林打叶的骤雨，不以为意，拄竹杖穿草鞋吟啸徐行，表现出从容不迫的姿态。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_translation_2",
          "text": "不用注意那穿林打叶的雨声，不妨一边吟咏长啸着，一边悠然地行走。竹杖和草鞋轻捷得胜过骑马...",
          "locator": "译文二",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "穿林打叶声：指大雨点透过树林打在树叶上的声音。吟啸：放声吟咏。芒鞋：草鞋。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "‘轻胜马’并非实指物理重量，而是心理上的轻松与精神豪迈。"
      ],
      "forbidden_assertions": [
        "词人实际骑马避雨",
        "‘芒鞋’指皮靴或官靴"
      ]
    },
    {
      "claim_id": "claim_04_metaphor_philosophy",
      "claim": "“一蓑烟雨任平生”与“也无风雨也无晴”借自然风雨隐喻人生政治风波与荣辱得失，表达超然旷达、随遇而安的人生境界。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "‘风雨’二字，一语双关，既指野外途中所遇风雨，又暗指几乎致他于死地的政治‘风雨’和人生险途。",
          "locator": "赏析二",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "一蓑烟雨任平生：披着蓑衣在风雨里过一辈子也处之泰然。也无风雨也无晴：意谓既不怕雨，也不喜晴。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "自然界的阴晴圆缺可映射人生际遇的顺逆起伏，词人主张以平常心对待。"
      ],
      "forbidden_assertions": [
        "‘风雨’仅指自然气象，毫无政治隐喻",
        "词人表达了对仕途彻底绝望的悲观情绪"
      ]
    },
    {
      "claim_id": "claim_05_textual_structure",
      "claim": "词前原有小序交代创作契机，正文以遇雨、徐行、天晴、回首为时间与情感脉络，层层递进。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "首两句是全篇枢纽...过片到‘山头斜照却相迎’三句，是过天晴的景象...结拍‘回首向来萧瑟处’...",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_original_3",
          "text": "三月七日，沙湖道中遇雨...已而遂晴，故作此词。",
          "locator": "原文版本三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "全词结构遵循‘遇雨-徐行-天晴-回首’的叙事逻辑，情景交融。"
      ],
      "forbidden_assertions": [
        "该词为单调小令，无上下片之分",
        "词中先写天晴后写遇雨"
      ]
    },
    {
      "claim_id": "claim_06_lexical_details",
      "claim": "词中“料峭”意为微寒，“向来”意为方才，“萧瑟”指风雨吹打树叶声，“已而”意为过了一会儿，“狼狈”指进退皆难的困顿窘迫之状。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_2",
          "text": "⑶狼狈：进退皆难的困顿窘迫之状。⑷已而：过了一会儿。⑼料峭：微寒的样子。⑾向来：方才。萧瑟：风雨吹打树叶声。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“萧瑟”在词中是写实的声音描写，与上片“穿林打叶声”相应和。"
      ],
      "forbidden_assertions": [
        "“萧瑟”在词中仅指词人内心凄凉，无写实风雨声含义",
        "“料峭”指极其寒冷的严冬气候"
      ]
    },
    {
      "claim_id": "claim_07_zen_influence",
      "claim": "词中“也无风雨也无晴”的禅悟深受《金刚经》“应无所住”思想的影响，展现了词人坦荡、任天而动的胸怀。",
      "status": "licensed_interpretation",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_2",
          "text": "其\"也无风雨\"的禅悟深受《金刚经》\"应无所住\"思想影响，清代郑文焯《手批东坡乐府》评：\"此足征是翁坦荡之怀，任天而动。\"",
          "locator": "创作背景二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "词人的旷达不仅是性格使然，也融入了深厚的佛禅哲理思考。"
      ],
      "forbidden_assertions": [
        "该词纯属即兴写景，不含任何哲学或宗教思想背景"
      ]
    },
    {
      "claim_id": "claim_08_homonymous_confusion",
      "claim": "《定风波》词牌下另有苏轼为王巩歌妓柔奴所作的“常羡人间琢玉郎”，两词背景、主题及内容完全不同，不应混淆。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_original_2",
          "text": "王定国歌儿曰柔奴...常羡人间琢玉郎...此心安处是吾乡。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "的好友王巩因为受到使苏轼遭杀身之祸的“乌台诗案”牵连...苏轼作此词以赞柔奴。",
          "locator": "创作背景一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "在检索或教学《定风波》时，需注意区分“莫听穿林打叶声”与“常羡人间琢玉郎”这两首同调异作。"
      ],
      "forbidden_assertions": [
        "“莫听穿林打叶声”是苏轼写给歌妓柔奴并赞美其高洁人品的词作"
      ]
    }
  ],
