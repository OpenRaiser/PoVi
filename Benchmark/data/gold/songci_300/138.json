{
  "schema_version": "0.2",
  "sample_id": "songci_300_138",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词为南宋初词人陈与义（字去非，号简斋）所作，词牌为《临江仙》。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "临江仙",
          "locator": "cipai",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "陈与义",
          "locator": "author",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "宋",
          "locator": "dynasty",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "陈与义（1090—1138），字去非，号简斋，北宋末南宋初洛阳人。",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可称陈与义为北宋末南宋初词人，此词作于其避乱流寓期间。",
        "词牌《临江仙》属宋代常见词调。"
      ],
      "forbidden_assertions": [
        "称作者为唐代诗人或北宋太平时期人物。",
        "将词牌误判为诗体或曲牌。"
      ]
    },
    {
      "claim_id": "claim_02_context_theme",
      "claim": "词作于端午节（午日），作者身处天涯避乱，感叹节令匆匆、年华老去，借凭吊屈原抒发家国之痛与身世之悲。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "午日：端午，即农历五月初五。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "这首《临江仙》所反映的是国家遭受兵乱时节，作者在节凭吊，旧怀伤时，借此来抒发自己的情怀。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "端午习俗与屈原投江的历史背景共同构成词作的情感基调。",
        "“天涯节序匆匆”暗含战乱流离、时光飞逝的无奈。"
      ],
      "forbidden_assertions": [
        "认为此词描写春日踏青或纯粹的个人闲愁。",
        "将“楚词”误解为泛指一般诗词而非特指屈原作品。"
      ]
    },
    {
      "claim_id": "claim_03_pomegranate_contrast",
      "claim": "“榴花不似舞裙红”以异乡榴花与昔日京师舞裙作对比，暗含对往昔繁华与个人盛年的追忆。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "言舞裙比石榴更红更美。这是怀念昔时生平岁月之意。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "用鲜艳灿烂的榴花比鲜红的舞裙，回忆过去春风得意、声名籍籍时的情景。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "舞裙象征昔日汴京的繁华宴乐与作者春风得意之时。",
        "榴花虽艳，却不及记忆中的舞裙，凸显今昔落差。"
      ],
      "forbidden_assertions": [
        "认为榴花比舞裙更美，或此句仅写自然景物无怀旧之意。",
        "将“舞裙”实指为某位具体歌女而非时代繁华的借代。"
      ]
    },
    {
      "claim_id": "claim_04_sunflower_symbol",
      "claim": "“戎葵凝笑墙东”借蜀葵向阳之性，象征词人虽年老流落他乡，但爱国忠贞之志始终不渝。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "戎葵：即蜀葵，夏日开花，花开五色，似木槿，有向阳特性。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "是借蜀葵向太阳的属性来喻自己始终如一的爱国思想。墙边五月的葵花，迎着东方的太阳开颜。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“凝笑”赋予植物人格化，映射作者旷达豪宕与坚贞不渝的爱国情怀。",
        "戎葵与榴花同为五月意象，共同构建节令与心境的对照。"
      ],
      "forbidden_assertions": [
        "认为戎葵仅指普通花草，或“凝笑”表达草木对作者的嘲讽。",
        "将“墙东”坐实为具体建筑方位而忽略其象征意。"
      ]
    },
    {
      "claim_id": "claim_05_wine_ritual",
      "claim": "“试浇桥下水，今夕到湘中”通过酹酒江水的动作，寄托对屈原的深切凭吊与思远意长之情。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "湘中：湘江水中。这里指屈原殉难处。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "面对湘江作者祭酒的虔诚，加上这杯中之酒肯定会流到汨罗江的联想，因而滔滔江水之中，融合了词人心灵深处的感情。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "桥下水连通湘江，象征情感跨越时空抵达屈原殉难处。",
        "“酒杯深浅去年同”以物是人非反衬时光流逝与悲愤之情。"
      ],
      "forbidden_assertions": [
        "认为作者只是随意倒酒，或湘中指代其他无关地点。",
        "将“试浇”理解为日常饮酒行为而非祭祀凭吊仪式。"
      ]
    },
    {
      "claim_id": "claim_06_creation_year_dispute",
      "claim": "关于此词的创作年份与地点，资料存在两说：一说作于建炎三年（1129年），词人流寓湖南、湖北一带；另一说作于建炎四年（1130年），词人流寓邵州（湖南邵阳）时。",
      "status": "disputed",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "此词是在公元1129年（建炎三年）所作，这一年，陈与义流寓湖南、湖北一带",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_background_1",
          "text": "此词为作者流寓邵州（湖南邵阳）时作，时为建炎四年（1130年）。",
          "locator": "创作背景一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "无论建炎三年或四年，此词均作于靖康之变后词人南渡避乱湖湘期间。"
      ],
      "forbidden_assertions": [
        "断定此词仅有建炎四年唯一创作年份记载。"
      ]
    },
    {
      "claim_id": "claim_07_textual_variants",
      "claim": "本词在不同版本中存在文字异同，如“戎葵”在部分版本中作“戌葵”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_version_1",
          "text": "万事一身伤老矣，戎葵凝笑墙东。",
          "locator": "原文版本一",
          "authority": "high"
        },
        {
          "source_id": "source_version_2",
          "text": "万事一身伤老矣，戌葵凝笑墙东。",
          "locator": "原文版本二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“戌葵”应为“戎葵”之传抄笔误或异体字。"
      ],
      "forbidden_assertions": [
        "认为“戌葵”是一种与“戎葵（蜀葵）”完全不同的植物。"
      ]
    }
  ],
