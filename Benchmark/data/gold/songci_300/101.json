{
  "schema_version": "0.2",
  "sample_id": "songci_300_101",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词为北宋词人周邦彦所作，词牌为《六丑》，属婉约派长调，作者精通音律并创制此调。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：六丑\n作者：周邦彦\n朝代：宋\n体裁：词\n词牌：六丑",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "周邦彦（1056—1121）...北宋著名词人...婉约派集大成者...其创制的《六丑》《花犯》等新调丰富了词牌形式。",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确标注本词为北宋婉约词代表作，作者为格律派宗师。",
        "可提及《六丑》词牌为周邦彦自度曲，音律极难。"
      ],
      "forbidden_assertions": [
        "将作者误标为唐代或豪放派词人。",
        "称《六丑》为前人旧调或民间俗曲。"
      ]
    },
    {
      "claim_id": "claim_02_theme",
      "claim": "全词借蔷薇凋谢之景，抒发客居他乡、光阴虚掷的怅惘，核心主旨为“惜花即惜人”的物我交融之情。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "这首词并非泛泛咏落花，而是抒发对花落后的“追惜”之情，更是对自己“光阴虚掷”的“追惜”之情。",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_translation_1",
          "text": "正是换单衣的时节，只恨客居异地，光阴白白地 流逝。",
          "locator": "译文一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可指出词人将个人羁旅漂泊之感投射于落花，形成身世之叹。",
        "教学可强调“追惜”二字贯穿全篇情感脉络。"
      ],
      "forbidden_assertions": [
        "认为本词仅为单纯写景咏物，毫无个人身世寄托。",
        "将“光阴虚掷”曲解为对具体政事或战事的感慨。"
      ]
    },
    {
      "claim_id": "claim_03_metaphor_allusion",
      "claim": "词中以“楚宫倾国”“钗钿”比喻蔷薇与落花，并化用唐代“红叶题诗”典故寄托落花之相思与眷恋。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "楚宫倾国：楚王宫里的美女，喻蔷薇花。倾国：美人，这里以之比落花。...钗钿堕处：花落处。...恐断红、尚有相思字：意指红花飘零时，对人间充满了依恋之情。用唐人卢渥和宫女在红叶上题诗的典故。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "这里活用红叶题诗故事，借指飘零的花瓣。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可说明比喻将落花女性化、人格化，增强凄美与哀婉意境。",
        "可指出典故的运用使自然景物承载了人文情感与历史联想。"
      ],
      "forbidden_assertions": [
        "将“楚宫倾国”解释为实指楚王宫历史事件或政治隐喻。",
        "认为“断红”仅指物理上的红色花瓣，完全剥离典故内涵。"
      ]
    },
    {
      "claim_id": "claim_04_lexical",
      "claim": "“试酒”为宋代风俗，指农历三月末或四月初尝新酒，用以点明暮春初夏的时令背景。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "试酒：宋代风俗，农历三月末或四月初偿新酒。...这里用以指时令。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可结合宋代民俗讲解时令转换与词人心理变化的关联。",
        "可说明“正”字点出节令更迭的当下性。"
      ],
      "forbidden_assertions": [
        "将“试酒”解释为饮酒作乐、试剑或无关的祭祀活动。",
        "忽略该词对全词时间背景的锚定作用。"
      ]
    },
    {
      "claim_id": "claim_05_structure",
      "claim": "词作上片侧重春归花谢之景与追问，下片转入东园寻花、人花互动及劝花莫去的深情，结构回环曲折。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "词作上片抒写春归花谢之景象。...词作下片着意刻画人惜花、花恋人的生动情景。",
          "locator": "赏析一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学可按上下片划分讲解层次，突出慢词铺叙展衍的特点。",
        "可指出下片“长条惹客”“残英强簪”“漂流断红”构成情感递进的三叹。"
      ],
      "forbidden_assertions": [
        "认为上下片内容割裂或叙事顺序颠倒。",
        "忽略词中“问语”与“逆挽”手法的结构功能。"
      ]
    },
    {
      "claim_id": "claim_06_lexical_details",
      "claim": "词中“过翼”指飞过的鸟；“桃蹊”指桃树下的路；“柳陌”指绿柳成荫的路；“巾帻”指头巾；“颤袅”指摇曳；“欹侧”指偏向一旁、向人表示依恋媚态。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "过翼：飞过的鸟。...桃蹊：桃树下的路。...柳陌：绿柳成荫的路。...强簪巾帻：勉强插戴在头巾上。巾帻：头巾。颤袅：摇曳。向人欹侧：向人表示依恋媚态。欹侧：偏向一旁。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "这些词汇的精细训诂有助于还原词作中微观景物的动态美与拟人化神态。"
      ],
      "forbidden_assertions": [
        "将“过翼”解释为飞机的机翼，或将“巾帻”解释为金属头盔。"
      ]
    },
    {
      "claim_id": "claim_07_allusion_chugong",
      "claim": "“葬楚宫倾国”句中，本应说“吴宫”（化用《哭花》诗“夜来风雨葬西施”），但因格律所限，故借用“楚宫”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "《哭花》诗：“若是有情争不哭，夜来风雨葬西施。”这里本应说吴宫，但为律所限，故借用“楚宫”。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "词人在格律限制与典故借用之间进行了艺术妥协，以“楚宫”代指美女葬身之所。"
      ],
      "forbidden_assertions": [
        "认为“楚宫倾国”是实指楚国历史上的某位特定王后。"
      ]
    },
    {
      "claim_id": "claim_08_six_chou_origin",
      "claim": "关于词牌《六丑》的命名，周邦彦曾对宋徽宗解释为：此调犯六个宫调，皆声之美者，但极难歌唱；古时高阳氏有子六人，才华出众但相貌丑陋，故以此为比喻。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "问《六丑》之义，莫能对，急召邦彦问之。对曰：“此犯六调，皆声之美者，然绝难歌。昔高阳氏有子六人，才而丑，故以比。”",
          "locator": "创作背景一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "《六丑》这一词牌名蕴含了音律上的复杂性与美学上的独特寄托。"
      ],
      "forbidden_assertions": [
        "认为《六丑》是指六个长相丑陋的普通人，与音乐格律无关。"
      ]
    },
    {
      "claim_id": "claim_09_textual_variants",
      "claim": "本词在不同版本中存在异文，如“怅客里”在版本二、版本五中作“恨客里”；“时叩窗槅”的“槅”在部分版本中写作“隔”；“渐朦胧暗碧”在版本二、三、四、五中作“渐蒙笼暗碧”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_version_1",
          "text": "怅客里、光阴虚掷...时叩窗槅...渐朦胧暗碧",
          "locator": "原文版本一",
          "authority": "high"
        },
        {
          "source_id": "source_version_2",
          "text": "恨客里、光阴虚掷...时叩窗隔...渐蒙笼暗碧",
          "locator": "原文版本二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“怅”与“恨”在情感表达上略有深浅之别，“朦胧”与“蒙笼”在视觉意境上各有侧重。"
      ],
      "forbidden_assertions": [
        "断定只有某一个版本是唯一正确的，全盘否定其他版本的异文。"
      ]
    }
  ],
