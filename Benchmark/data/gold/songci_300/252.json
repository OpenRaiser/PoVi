{
  "schema_version": "0.2",
  "sample_id": "songci_300_252",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词为南宋遗民词人刘辰翁于元成宗大德元年（1297年）元宵夜所作，词牌为《宝鼎现》，主旨为寄托亡国哀思。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "宝鼎现",
          "locator": "title",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "这首词作于公元1297年（元成宗大德元年）。在宋亡近二十年后的元宵夜，作者感慨今昔，写下这首《宝鼎现》，寄托亡国哀思。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "刘辰翁（1232—1297）...入元不仕。宋亡前后，多感伤时事的篇章。",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确该词创作于宋亡后约二十年，属典型的遗民词范畴。",
        "作者身份与创作时间直接决定了全词悲凉沉郁的情感基调。"
      ],
      "forbidden_assertions": [
        "该词作于北宋宣和年间",
        "作者刘辰翁在元朝出仕为官",
        "词作主旨仅为描写元宵佳节游玩之乐"
      ]
    },
    {
      "claim_id": "claim_02_structure",
      "claim": "全词分三叠，分别铺陈北宋汴京元宵繁华、南宋临安承平景象以及入元后元宵萧条与遗民悲泣，通过今昔对比抒发故国之思。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "这首词就分三段分别写北宋、南宋及作词当时的节场景。因此形成强烈的对比，以现作者悼念恨怅之情。",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "红妆春骑...天上人间梦里。",
          "locator": "l01-l12",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "词作采用时空跳跃与强烈对比手法，教学时应引导学生按朝代更迭划分三段层次。",
        "三叠结构内在逻辑紧密，情感由盛转衰，层层递进。"
      ],
      "forbidden_assertions": [
        "全词仅描写单一时代的元宵节",
        "三段之间为并列的景物堆砌，无情感递进",
        "上阕与下阕描写的是同一时空"
      ]
    },
    {
      "claim_id": "claim_03_allusion_copper",
      "claim": "词中“抱铜仙、清泪如水”借用魏明帝拆迁汉武铜人潸然泪下的典故，隐喻北宋灭亡、故国沦丧的悲痛。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "抱铜仙清泪如水：此句运用金铜仙人的典故。魏明帝时诏宫官牵牛西取汉武帝时所造的铜人，铜人竟潸然泪下，用这典故寄寓作者亡国之痛。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "父老犹记宣和事，抱铜仙、清泪如水。",
          "locator": "l05",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "该典故是全词情感由北宋转入南宋/亡国叙事的关键枢纽。",
        "“清泪如水”将历史典故具象化为父老遗民的现实悲泣。"
      ],
      "forbidden_assertions": [
        "铜仙流泪指代自然降雨或天气变化",
        "此典故与朝代更迭或政治变迁无关",
        "宣和事仅指宋徽宗个人爱好"
      ]
    },
    {
      "claim_id": "claim_04_mirror",
      "claim": "“肯把菱花扑碎”反用南朝徐德言破镜重圆典故，以反问语气表达在繁华表象下对国破家亡悲剧的隐忧与无奈。",
      "status": "licensed_interpretation",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "有没有人象南朝徐德言那样预料到将有国破家亡之祸，而预先将菱花镜打破，与妻子各执一半，以作他日团圆的凭证。“肯把菱花扑碎”一句，寓有词人刻骨铭心的亡国之痛",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "poem",
          "text": "看往来、神仙才子，肯把菱花扑碎。",
          "locator": "l08",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可指出此处为反诘，暗示时人沉溺享乐，未料大祸将至。",
        "菱花镜的“碎”象征家国完整性的不可挽回。"
      ],
      "forbidden_assertions": [
        "菱花扑碎指代打碎酒杯或器物",
        "此句纯粹描写女子梳妆打扮的日常",
        "破镜典故在此处表示夫妻团圆"
      ]
    },
    {
      "claim_id": "claim_05_nichang",
      "claim": "结句“便当日亲见《霓裳》，天上人间梦里”化用李煜《浪淘沙》语意，强调即使亲历过北宋极盛，如今也如隔世般虚幻，深化亡国幻灭感。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "“天上人间梦里”用李后主《浪淘沙》“流水落花春去也，天上人间”语，辞气悲凉亡国之痛。跃然纸上，读之令人抚膺大恸。",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "霓裳：《霓裳羽衣曲》与《霓裳羽衣舞》的略称。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "poem",
          "text": "便当日亲见《霓裳》，天上人间梦里。",
          "locator": "l12",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "结句是全词情感高潮，教学需点明其与李煜词的互文关系。",
        "“天上人间”在此处指代故国繁华与当下凄凉的巨大落差。"
      ],
      "forbidden_assertions": [
        "《霓裳》指代唐代某位具体宫女或现代舞蹈",
        "天上人间指代地理上的南北方划分",
        "结句表达的是对梦境的向往而非幻灭"
      ]
    },
    {
      "claim_id": "claim_06_lexical_allusions",
      "claim": "词中“彩鸾”用唐代裴航与云英、或太和末年裴航与樊彩鸾结为夫妇的传说（此处指大和末年彩鸾与文箫结为夫妇的传说），“金吾”指执金吾禁夜制度，元夕特许弛禁。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "大和末年，有一叫彩鸾的绝代女子和一前观中的相恋，结为夫妇。“箫声断，约彩鸾归去”即用此事来摹写男女恋事。古代京城有执金吾（执金吾）禁夜制度，“唯正月十五日夜，敕许金吾弛禁，前后各一日。”“未怕金吾呵醉”写出元夕夜禁令不张，自由欢乐的氛围。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "poem",
          "text": "箫声断、约彩鸾归去，未怕金吾呵醉。",
          "locator": "l03",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“约彩鸾归去”借仙侣传说描摹元夕男女相约、自由恋爱的浪漫情景。",
        "“未怕金吾呵醉”体现了元宵节打破平日宵禁、全城狂欢的特殊民俗背景。"
      ],
      "forbidden_assertions": [
        "彩鸾在词中指代真实的鸟类",
        "金吾在词中指代某种乐器或武器"
      ]
    },
    {
      "claim_id": "claim_07_lexical_music",
      "claim": "“念奴”借指唱技精妙的歌女；“三千乐指”指宋代教坊乐队旧例，由三百人组成，一人十指，故称“三千乐指”。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "念奴：本是唐天宝中名娼，此借用以说明唱技之精。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "三千乐指：宋时旧例，教坊乐队由三百人组成，一人十指，故称“三千乐指”。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "poem",
          "text": "听得念奴歌起...空见说、三千乐指。",
          "locator": "l04,l09",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“三千乐指”是宫廷音乐盛况的代称，入元后儿童只能“空见说”，表现了盛世不再的悲凉。"
      ],
      "forbidden_assertions": [
        "三千乐指指三千名乐师",
        "念奴是词人当时亲眼所见的唐代歌女"
      ]
    }
  ],
