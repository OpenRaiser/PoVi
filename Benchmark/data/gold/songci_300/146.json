{
  "schema_version": "0.2",
  "sample_id": "songci_300_146",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词为宋代词人万俟咏所作，词牌为《三台》，系宋徽宗时期作者任大晟府乐官时奉诏创作的应制词。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：三台 作者：万俟咏 朝代：宋 体裁：词 词牌：三台",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "这首词是宋徽宗时任大晟府乐官时奉皇帝之命所作。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "徽宗政和初年，召试补官，授大晟府制撰。",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确该词为宫廷应制之作，具有官方礼仪与颂圣性质。",
        "作者身份为专业乐官，精通音律，故词作格律严谨。"
      ],
      "forbidden_assertions": [
        "该词为万俟咏贬谪或隐居时期的个人抒情之作。",
        "词牌《三台》为万俟咏自创。"
      ]
    },
    {
      "claim_id": "claim_02_structure",
      "claim": "全词采用赋体铺陈手法，分上、中、下三片，依次描写宫苑春景、市井游冶与清明赐火休务。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "全词用赋的铺张扬厉之笔法极力铺叙京城清明时节的节序风光……词分上、中、下三片，上片写宫苑中的春景，由内及外；中片写郊外之游……下片写贵族宅院中的喜庆景象。",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "统观全篇，是一种竭力罗列铺陈的赋体写法。全词铺叙勾勒，脉络清晰，层次分明，处处照应。",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学时应按三片结构划分讲解层次，突出空间由宫廷向民间再向朝堂的推移。",
        "铺陈手法是理解本词艺术特色的核心切入点。"
      ],
      "forbidden_assertions": [
        "该词为上下两阕结构。",
        "全词以抒情为主，缺乏叙事与写景的层次。"
      ]
    },
    {
      "claim_id": "claim_03_theme",
      "claim": "词作主旨为颂扬清明时节的太平盛世与朝野同乐，但赏析指出其带有应制体粉饰太平的程式化特征。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "粉饰出一片虚假的太平繁荣景象。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "就当时文学现象中不可缺少的一种诗词体式“应制体”来看，也还是写得比较成功的……全词也在这样一片太平祥和的氛围中戛然而止。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "解读时应结合“应制”背景，理解其颂圣意图与文学史定位。",
        "可探讨“虚假太平”评价背后的文学批评视角。"
      ],
      "forbidden_assertions": [
        "该词纯粹是作者对民间疾苦的隐晦批判。",
        "词中毫无政治颂扬色彩，仅为纯自然写景。"
      ]
    },
    {
      "claim_id": "claim_04_imagery_auspicious",
      "claim": "“非烟非雾”（l03）并非单纯写景，而是指代祥瑞之气，用以烘托宫阙的尊贵与盛世气象。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "非烟非雾：指祥瑞之气。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "非烟非雾：指祥瑞之气。《汉书·天文志》：“若烟非烟，若云非云……是谓庆云。”",
          "locator": "注释二",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "烘托出帝王之家的祥和与高贵。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "该意象是连接自然春景与政治祥瑞的关键符号。",
        "可结合汉代典籍理解古人对天象的政治化解读。"
      ],
      "forbidden_assertions": [
        "“非烟非雾”仅指春日清晨的普通水汽或雾霾。",
        "该词暗示宫廷内部存在阴谋或动荡。"
      ]
    },
    {
      "claim_id": "claim_05_customs_qingming",
      "claim": "下片集中描写寒食清明习俗，包括禁火、试新妆、传蜡炬、休务等，展现节令更迭与朝廷恩典。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "禁火：古俗寒食日禁火三天。住传宣：停止传旨、宣官员上殿。休务：停止公务。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "下片借清明习俗禁火，宫中以蜡烛分赐近臣，及弛禁开门，住宣休务等事，写皇上降恩，与百僚同乐，以此颂圣。",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "清明赐火是宋代重要的宫廷礼仪，象征皇恩浩荡。",
        "休务与敛兵卫共同构成“太平”的具体政治表征。"
      ],
      "forbidden_assertions": [
        "禁火习俗源于唐代宫廷独创。",
        "休务指官员因战乱被迫停止办公。"
      ]
    },
    {
      "claim_id": "claim_06_metonymy_nobility",
      "claim": "“槐府”（l11）借指朝廷权贵或重臣的府邸，源于古代贵宅门前植槐的传统。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "槐府：贵人宅第，门前植槐。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "槐府：贵人宅第，门前植槐。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "该词运用了典型的借代修辞，以植物特征代指社会阶层。",
        "翠烟飞入槐府暗示恩泽直达权臣之家。"
      ],
      "forbidden_assertions": [
        "“槐府”指代普通的乡村农舍。",
        "槐树在此处仅作为清明时令植物出现，无社会阶层指涉。"
      ]
    },
    {
      "claim_id": "claim_07_textual_variants",
      "claim": "关于l11，不同版本存在异文，版本一作“清明看、汉蜡传宫炬”，版本二、三作“清明看、汉宫传蜡炬”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_ver_1",
          "text": "清明看、汉蜡传宫炬，散翠烟、飞入槐府。",
          "locator": "原文版本一",
          "authority": "high"
        },
        {
          "source_id": "source_ver_2",
          "text": "清明看、汉宫传蜡炬。散翠烟、飞入槐府。",
          "locator": "原文版本二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "两处异文均指向清明时节宫廷向臣下传赐蜡烛的典故。",
        "“汉宫传蜡炬”与唐代韩翃《寒食》诗句“日暮汉宫传蜡烛”更为接近。"
      ],
      "forbidden_assertions": [
        "“汉蜡传宫炬”是万俟咏唯一的原始手稿写法，其他版本均为伪造。"
      ]
    },
    {
      "claim_id": "claim_08_lexical_qingmen",
      "claim": "“青门”（l02）原指汉长安东南门，后泛指京城城门。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "青门：汉长安东南门，后泛指京城城门。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "此处用“青门”代指宋代汴京的城门，体现了古典诗词用汉代典故代指当朝事物的习惯。"
      ],
      "forbidden_assertions": [
        "“青门”在词中特指某扇漆成青绿色的普通民居大门。"
      ]
    },
    {
      "claim_id": "claim_09_lexical_yaotao",
      "claim": "“夭桃”（l07）意为茂盛而艳丽的桃花，语出《诗经·周南·桃夭》。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_2",
          "text": "夭桃：茂盛而艳丽的桃花。语出《诗·周南·桃夭》：“桃之夭夭，灼灼甚华。”",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“夭桃朱户”借用人面桃花的意象，暗示踏青路上青年男女的爱恋与邂逅。"
      ],
      "forbidden_assertions": [
        "“夭桃”是指夭折、枯萎的桃树。"
      ]
    }
  ],
