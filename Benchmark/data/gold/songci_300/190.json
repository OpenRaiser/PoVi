{
  "schema_version": "0.2",
  "sample_id": "songci_300_190",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《扬州慢》为南宋词人姜夔自度曲，其词风以清空、清雅、空灵含蓄著称，千岩老人认为此词有《黍离》之悲。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：扬州慢；作者：姜夔；朝代：宋；词牌：扬州慢",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "其词清空峻拔，如野云孤飞，去留无迹。",
          "locator": "作者简介一",
          "authority": "medium"
        },
        {
          "source_id": "source_original_2",
          "text": "因自度此曲。千岩老人以为有《黍离》之悲也。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "这首词充分体现了作者认为的诗歌要“含蓄”和“句中有余味，篇中有余意”的主张，也是历代词人抒发“黍离之悲”而富有余味的罕有佳作。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可在教学中明确该词为姜夔首创词调，并强调其清空含蓄的艺术风格。"
      ],
      "forbidden_assertions": [
        "称该词为前人旧调填词",
        "将作者误标为唐代或明代诗人",
        "称其词风豪放或婉约浓艳"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "此词作于宋孝宗淳熙三年（1176）冬至，作者二十余岁初访扬州，目睹金兵劫掠后的萧条景象而作。金兵南侵事件包括绍兴三十一年（1161）金主完颜亮南侵。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "这首词当作于宋孝宗淳熙三年（1176）冬至日，时二十余岁。根据词前小序所说，其时作者初访扬州。这是经过最近两次战乱洗劫过的扬州。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_background_2",
          "text": "公元1161年（宋高宗绍兴三十一年），金主完颜亮南侵，江淮军败，中外震骇。完颜亮不久在瓜州为其臣下所杀。根据此前小序所说，淳熙三年，姜夔因路过扬州，目睹了战争洗劫后扬州的萧条景象，抚今追昔，有感而发。",
          "locator": "创作背景二",
          "authority": "high"
        },
        {
          "source_id": "source_original_2",
          "text": "淳熙丙申至日，予过维扬。夜雪初霁，荠麦弥望。入其城，则四顾萧条。",
          "locator": "原文版本二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "创作时间可精确到1176年冬至，历史背景为金兵南侵后的战后扬州。"
      ],
      "forbidden_assertions": [
        "创作于北宋时期或明清时期",
        "背景为太平盛世游历或单纯个人羁旅思乡"
      ]
    },
    {
      "claim_id": "claim_03_imagery_contrast",
      "claim": "词中通过“春风十里”“名都”与“荠麦青青”“废池乔木”“空城”的强烈对比，展现扬州昔盛今衰。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "全词分为上下两阕。但两阕的写作手法都是运用一种鲜明对比，用昔日扬州城的繁荣兴盛景象对比现时扬州城的凋残破败惨状。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "春风十里：指昔日繁华的扬州道上。废池乔木：废毁的池台，残存的古树。二者都是乱后余物，表明城中荒芜，人烟萧条。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "上阕以今昔景物并置形成视觉与心理反差，突出战争对城市的毁灭性破坏。"
      ],
      "forbidden_assertions": [
        "认为全词仅客观记录扬州春日风光",
        "否认词中存在今昔对比结构"
      ]
    },
    {
      "claim_id": "claim_04_allusion_theme",
      "claim": "下阕化用杜牧扬州诗境，借“杜郎”“豆蔻”“青楼”“二十四桥”反衬今日荒凉，寄托“黍离之悲”。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "词的下阕，运用典故，进一步深化了“黍离之悲”的主题。……借“杜郎”史实，逗出和反衬“难赋”之苦。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "杜郎：即杜牧。豆蔻：形容少女美艳。青楼梦好：杜牧《遣怀》诗。二十四桥：扬州城内古桥。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_translation_1",
          "text": "千岩老人认为这首词有《黍离》的悲凉意蕴。",
          "locator": "译文一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "杜牧典故并非单纯怀古，而是作为昔日繁华的参照系，服务于家国残破的悲叹。"
      ],
      "forbidden_assertions": [
        "认为下阕主旨为追慕杜牧风流艳事",
        "将“黍离之悲”曲解为个人仕途失意或男女离愁"
      ]
    },
    {
      "claim_id": "claim_05_technique",
      "claim": "全词运用移情入景与乐景写哀手法，如“废池乔木，犹厌言兵”“波心荡冷月无声”“年年知为谁生”，赋予景物以悲情。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "情景交融是这首词在写作表现手法上最显著的一个特点。移情入景，乐景写哀，都是词人经常使用的手法。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "废池乔木：废毁的池台，残存的古树。红药：红芍药花，是扬州繁华时期的名花。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "景物描写并非纯客观白描，而是词人主观悲怆情感的外化与投射。"
      ],
      "forbidden_assertions": [
        "认为“犹厌言兵”仅为拟人修辞游戏，无深层历史痛感",
        "认为结句红药仅为植物学记录"
      ]
    },
    {
      "claim_id": "claim_06_lexical_details",
      "claim": "词中“淮左”指淮南东路，扬州为首府；“竹西”指竹西亭，为扬州名胜；“胡马窥江”指金兵侵略长江流域地区，洗劫扬州；“清角”指凄清的号角声；“红药”指红芍药花。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "淮左名都：指扬州。宋朝的行政区设有淮南东路和淮南西路，扬州是淮南东路的首府，故称淮左名都。竹西：竹西亭，扬州名胜之一。胡马窥江：指金兵侵略长江流域地区，洗劫扬州。清角：凄清的号角声。红药：红芍药花，是扬州繁华时期的名花。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "词中词汇多有特定历史地理指代，需结合宋代行政区划及战乱背景理解。"
      ],
      "forbidden_assertions": [
        "将淮左解释为淮河以西",
        "将红药解释为普通红色草药"
      ]
    }
  ],
