  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词为北宋词人柳永所作的词，词牌为《凤栖梧》（又名《蝶恋花》），是一首怀人之作。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：凤栖梧・蝶恋花 作者：柳永 朝代：宋 体裁：词",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "柳永（约984—1053）……北宋著名词人",
          "locator": "作者简介一",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "这是一首怀人之作",
          "locator": "创作背景一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确标注该词为宋代婉约派词的代表作",
        "可结合柳永生平说明其词多写市井情思与羁旅漂泊"
      ],
      "forbidden_assertions": [
        "该词为唐代作品",
        "作者为苏轼或晏殊等其他词人",
        "体裁为近体诗或绝句"
      ]
    },
    {
      "claim_id": "claim_02_theme_structure",
      "claim": "全词仅首句叙事，余皆抒情；上片登楼望远引出“春愁”，下片借酒遣愁未果，最终揭示“春愁”实为坚贞相思，采用“曲径通幽”的结构手法。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "全词只此一句叙事，便把主人公的外形像一幅剪纸那样突现出来了……采用“曲径通幽”的表现方式",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "下片作者把笔宕开，写他如何苦中求乐……至此，作者才透露这种“春愁”是一种坚贞不渝的感情",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可指出该词上景下情、层层递进的章法特点",
        "可强调“春愁”为全词情感线索"
      ],
      "forbidden_assertions": [
        "全词以叙事为主",
        "上下片情感毫无关联",
        "词人直接点明愁绪而无铺垫"
      ]
    },
    {
      "claim_id": "claim_03_imagery_grass",
      "claim": "“草色烟光残照里”以黄昏春草与迷蒙烟光烘托孤寂凄凉，芳草意象暗喻愁恨连绵与倦游思归。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "芳草萋萋，刬尽还生，很容易使人联想到愁恨的连绵无尽。借用春草，表示自己已经倦游思归",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "烟光：飘忽缭绕的云霭雾气。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可说明景物描写为抒情定下凄美基调",
        "可指出“残照”暗示时间流逝与主人公久久伫立"
      ],
      "forbidden_assertions": [
        "草色象征生机勃勃的喜悦",
        "烟光指代清晨的雾气",
        "该句为纯客观写景无情感寄托"
      ]
    },
    {
      "claim_id": "claim_04_famous_line",
      "claim": "“衣带渐宽终不悔，为伊消得人憔悴”化用《古诗十九首》，直抒胸臆，表明甘愿为所爱之人（或人生理想）憔悴消瘦而无悔的执着情感。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "衣带渐宽：指人逐渐消瘦。语本《古诗十九首》：“相去日已远，衣带日已缓”。消得：值得。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "即使渐渐形容憔悴、瘦骨伶仃，也决不后悔。“为伊消得人憔悴”才一语破的：词人的所谓“春愁”，不外是“相思”二字",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_background_2",
          "text": "“伊人”，可能指其红颜知己……暗含了词人自身功业无成、人生困顿的悲凉",
          "locator": "创作背景二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可指出该句为全词情感高潮与主旨句",
        "可引申为后世治学、追求理想的励志名句"
      ],
      "forbidden_assertions": [
        "“消得”意为消耗殆尽",
        "该句表达的是对饮酒的后悔",
        "“伊”仅指代词人自己"
      ]
    },
    {
      "claim_id": "claim_05_background",
      "claim": "此词具体创作时间不详，一般认为作于柳永仕途失意、漂泊江湖期间，融合了个人身世之感与男女恋情。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "具体创作时间不详。当时漂泊异乡，因怀念意中人而作此词。",
          "locator": "创作背景一",
          "authority": "medium"
        },
        {
          "source_id": "source_background_2",
          "text": "一般认为作于柳永仕途失意、漂泊江湖期间……是柳永将个人身世之感与男女恋情融为一体的典范之作",
          "locator": "创作背景二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可结合柳永屡试不第的经历理解词中“落魄感受”",
        "可说明宋代文人常将仕途失意寄托于儿女情长"
      ],
      "forbidden_assertions": [
        "该词作于柳永高中进士之后",
        "词中毫无身世之叹仅写风月",
        "创作于南宋时期"
      ]
    },
    {
      "claim_id": "claim_06_lexical_details",
      "claim": "词中“伫倚危楼”意为长时间倚靠在高楼的栏杆上，其中“伫”为久立，“危楼”指高楼；“黯黯”形容神情沮丧、情绪低落或迷蒙不明；“会”意为理解；“阑”通“栏”；“拟把”意为打算；“疏狂”指狂放不羁；“强乐”指勉强欢笑，“强”读qiǎng，意为勉强；“消得”意为值得或能忍受得了。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "伫倚危楼：长时间倚靠在高楼的栏杆上。伫，长时间站立。危楼，高楼。黯黯：神情沮丧，情绪低落。会：理解。阑：同“栏”。拟把：打算。疏狂：狂放不羁。强乐：勉强欢笑。强，勉强。消得：值得。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_2",
          "text": "伫，久立。黯黯：迷蒙不明，形容心情沮丧忧愁。强（qiǎng）乐：勉强欢笑。消得：值得，能忍受得了。",
          "locator": "注释二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“危楼”在古汉语中并非指危险、快要倒塌的楼房，而是指高耸之楼"
      ],
      "forbidden_assertions": [
        "危楼指危险的破楼",
        "强乐指强烈的快乐",
        "消得指消耗殆尽"
      ]
    },
    {
      "claim_id": "claim_07_alternative_reading_text",
      "claim": "本词在不同版本中存在标点断句的差异，如“伫倚危楼风细细”后，版本一用逗号，版本二用句号；且版本二明确指出“阑”通“栏”。",
      "status": "disputed",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_version_1",
          "text": "伫倚危楼风细细，望极春愁，黯黯生天际。",
          "locator": "原文版本一",
          "authority": "high"
        },
        {
          "source_id": "source_version_2",
          "text": "伫倚危楼风细细。望极春愁，黯黯生天际。草色烟光残照里。无言谁会凭阑意。(阑 通 栏)",
          "locator": "原文版本二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "不同版本的断句差异不影响词作整体抒情脉络"
      ],
      "forbidden_assertions": [
        "所有古籍版本中本词的标点和字形完全一致"
      ]
    }
  ],
