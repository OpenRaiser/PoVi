  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本作品为宋代皇帝赵佶（宋徽宗）所作的词，词牌为《燕山亭》。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：燕山亭；作者：赵佶；朝代：宋；体裁：词；词牌：燕山亭",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "赵佶（1082—1135） 即宋徽宗，宋神宗之子...公元1100～1125年在位。",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确该词为帝王之作，且作者身份为北宋末代君主。",
        "可结合其艺术全才背景，解释词中工笔描写的审美来源。"
      ],
      "forbidden_assertions": [
        "该词为其他宋代词人所作。",
        "体裁误判为诗或曲。"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "此词作于1127年靖康之变后，作者与其子钦宗被金兵掳往北方五国城的途中，是其身世遭遇的悲惨写照。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "此词是宋徽宗于1127年覆国后与其子钦宗被金兵掳往北方五国城时途中，途中见杏花而托物兴感而作，是作者身世遭遇的悲惨写照。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_background_2",
          "text": "《燕山亭·北行见杏花》此词是宋徽宗赵佶于1127年覆国后与其子钦宗赵桓被金兵掳往北方五国城时途中...途中见杏花而托物兴感而作。",
          "locator": "创作背景二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "词中“天遥地远”“故宫何处”等句具有明确的北行囚徒视角。",
        "创作时间与北宋灭亡、徽宗被俘的历史节点高度吻合。"
      ],
      "forbidden_assertions": [
        "该词作于作者登基初期或太平盛世。",
        "创作背景与金兵南下、被俘北行无关。"
      ]
    },
    {
      "claim_id": "claim_03_upper_imagery",
      "claim": "词的上片（l01-l05）以工笔手法细致描绘杏花的形态、色泽与香气，将其比作冰绡、胭脂与盛装美人。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "词之上片先以细腻的笔触工笔、描绘杏花，外形而及神态，勾勒出一幅绚丽的杏花图。杏花的瓣儿好似一叠叠冰清玉洁的缣绸...又逐步匀称地晕染上浅淡的胭脂。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "冰绡：洁白的丝绸，比喻花瓣。（1） 胭脂：原文“燕脂”，通假字。（2） 靓妆：美丽的妆饰。（3） 蕊珠宫女：指仙女。蕊珠，道家指天上仙宫。（4）",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "上片侧重客观物象的精细刻画，为下片抒情蓄势。",
        "“羞杀蕊珠宫女”运用夸张与衬托手法突出杏花之美。"
      ],
      "forbidden_assertions": [
        "上片描写的是牡丹或梅花。",
        "上片已直接抒发亡国之痛，无咏物成分。"
      ]
    },
    {
      "claim_id": "claim_04_lower_emotion",
      "claim": "词的下片（l06-l11）由咏物转入直抒胸臆，表达被掳北行的重重离恨、对故国的深切思念，以及连梦境亦无法归乡的绝望。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_translation_3",
          "text": "我被拘押着向北行进，凭谁来寄托这重重离恨？...天遥地远，已经走过了万水千山，又怎么知道故宫此时的情形？...可又不知是什么原因，最近几天，竟连做梦也无法做成。",
          "locator": "译文三",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "词通过写杏花的凋零，借以哀伤自己悲苦无告、横遭摧残的命运。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“者双燕”反用传统燕传书信的意象，强调音信断绝。",
        "“和梦也、新来不做”将愁苦推向极致，体现精神防线的彻底崩溃。"
      ],
      "forbidden_assertions": [
        "下片表达的是对春天逝去的单纯惋惜。",
        "作者对归乡仍抱有现实希望。"
      ]
    },
    {
      "claim_id": "claim_05_metaphor_link",
      "claim": "全词以杏花“易得凋零”与“无情风雨”暗喻作者自身从帝王尊位跌落至阶下囚的悲惨命运，属典型的托物言志。",
      "status": "licensed_interpretation",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "途中见杏花而托物兴感而作，是作者身世遭遇的悲惨写照。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_background_2",
          "text": "途中见杏花而托物兴感而作，是作者身世遭遇的悲惨写照。",
          "locator": "创作背景二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "杏花的盛极而衰与徽宗的国破家亡形成同构映射。",
        "“风雨”既可指自然气候，也可指金兵南下的政治风暴。"
      ],
      "forbidden_assertions": [
        "杏花仅为自然景物，与作者命运毫无关联。",
        "词中未使用任何象征或隐喻手法。"
      ]
    },
    {
      "claim_id": "claim_06_lexical_basic",
      "claim": "词中“冰绡”、“燕脂”、“靓妆”、“蕊珠宫女”等词语，生动描绘了杏花的形色与神态。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "冰绡：洁白的丝绸，比喻花瓣。（1） 胭脂：原文“燕脂”，通假字。（2） 靓妆：美丽的妆饰。（3） 蕊珠宫女：指仙女。蕊珠，道家指天上仙宫。（4）",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "①裁剪冰绡（xiāo），轻叠数重，淡着燕脂匀注：写杏花的形色。冰绡，白色丝绸，用来比喻花瓣。燕脂，同胭脂。②靓妆：用脂粉打扮。③蕊珠宫女：仙女。蕊珠宫是道教传说中的仙宫。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“冰绡”和“燕脂”分别从质感、色彩上对杏花进行拟物化比喻。",
        "“蕊珠宫女”的比喻为杏花增添了超尘脱俗的仙子气质。"
      ],
      "forbidden_assertions": [
        "“冰绡”在词中指真正的丝绸衣服。",
        "“蕊珠宫女”指宋代宫廷中的普通宫女。"
      ]
    },
    {
      "claim_id": "claim_07_lexical_grammatical",
      "claim": "词中关键虚词与通假字如“者”（同“这”）、“无据”（不知何故/没有凭据）、“和”（连）对准确理解下片情感递进至关重要。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "者：同“这”。（6） 无据：不知何故。（7） 和：连。（8）",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "④凭寄：寄托。⑥和梦也新来不做：和，连。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“无据”解释了梦境中断的突兀感与无奈感。",
        "“和”字在古汉语中常表递进或连带，此处强调连最后的精神寄托也丧失。"
      ],
      "forbidden_assertions": [
        "“者”指代作者本人。",
        "“无据”意为没有证据或事实依据。"
      ]
    },
    {
      "claim_id": "claim_08_alternative_readings",
      "claim": "本词在不同版本中存在异文，如“轻叠数重”在版本二中作“打叠数重”，“淡著燕脂”作“冷淡燕脂”，“问院落凄凉”作“闲院落凄凉”，“新来不做”作“有时不做”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_version_1",
          "text": "裁翦冰绡，轻叠数重，淡著燕脂匀注。...问院落凄凉，几番春暮？...和梦也、新来不做。",
          "locator": "原文版本一",
          "authority": "high"
        },
        {
          "source_id": "source_version_2",
          "text": "裁翦冰绡，打叠数重，冷淡燕脂匀注。...闲院落凄凉，几番春暮。...和梦也、有时不做。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_version_3",
          "text": "裁剪冰绡，轻叠数重，淡著燕脂匀注。...闲院落凄凉，几番春暮。...和梦也新来不做。",
          "locator": "原文版本三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“淡著”与“冷淡”在色彩饱和度与情感色彩上存在细微差别。",
        "“新来不做”与“有时不做”在表达愁苦的持续性与彻底性上有所不同。"
      ],
      "forbidden_assertions": [
        "所有版本在字句上完全一致，没有任何异文。"
      ]
    }
  ],
