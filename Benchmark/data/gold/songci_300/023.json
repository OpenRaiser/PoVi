{
  "schema_version": "0.2",
  "sample_id": "songci_300_023",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《采桑子·群芳过后西湖好》为北宋欧阳修晚年退居颍州时所作，属《采桑子》组词之一。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：采桑子；作者：欧阳修；朝代：宋；体裁：词",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "本词作于公元1071年（熙宁四年），这年六月，欧阳修以太子少师的身份辞职，回到颍州。暮春时节来到西湖游玩，心生喜悦而作《采桑子》十首。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "欧阳修（1007—1072）……晚年自号“六一居士”……",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "可明确该词为欧阳修晚年退居颍州期间所作，反映其辞官后的心境。",
        "该词是《采桑子》组词中的一首，非独立孤篇。"
      ],
      "forbidden_assertions": [
        "该词作于欧阳修早年或贬谪时期。",
        "该词非欧阳修所作或为伪托。",
        "该词与颍州西湖无关。"
      ]
    },
    {
      "claim_id": "claim_02_l01_imagery",
      "claim": "上片以白描手法勾勒暮春西湖景物：残红散落、柳絮迷蒙、垂柳随风，突出“好”字，无伤春之意。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_translation_1",
          "text": "虽说是百花凋落，暮春时节的西湖依然是美的，残花轻盈飘落……柳絮时而飘浮，时而飞旋……杨柳向下垂落……",
          "locator": "译文一",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "群芳过后：百花凋零之后。狼籍残红：残花纵横散乱的样子。蒙蒙：细雨迷蒙的样子，以此形容飞扬的柳絮。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "上片侧重客观写景，通过“残红”“飞絮”“垂柳”展现暮春特有的生机与动态美。",
        "“好”字定下全词情感基调，表明词人对暮春景色的欣赏而非哀叹。"
      ],
      "forbidden_assertions": [
        "上片表达了强烈的伤春悲秋或迟暮之悲。",
        "“狼籍”指狼群聚集或贬义混乱。",
        "“蒙蒙”形容大雨倾盆。"
      ]
    },
    {
      "claim_id": "claim_03_l02_mood",
      "claim": "下片写游人散去、笙歌停歇后，词人垂帘静观双燕归巢，体悟到繁华落尽后的空寂与安谧，心境安闲自适。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_translation_2",
          "text": "游人尽兴散去，笙箫歌声也渐渐静息，才开始觉得一片空寂，又仿佛正需要这份安谧。……只见双燕从蒙蒙细雨中归来，这才拉起了帘子。",
          "locator": "译文二",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "虽写残春景色，却无伤春之感……创造出一种清幽静谧的艺术境界。而词人的安闲自适，也就在这种境界中自然地表现出来。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“春空”并非消极虚无，而是喧嚣褪去后内心的澄明与对宁静的主动接纳。",
        "双燕归来与细雨交织，强化了词人寄情自然、超然物外的闲适情怀。"
      ],
      "forbidden_assertions": [
        "“春空”指春天完全结束令人绝望或空虚。",
        "“双燕”象征词人渴望重返朝廷或政治抱负。",
        "下片表达了孤独寂寞与人生失意。"
      ]
    },
    {
      "claim_id": "claim_04_artistic_style",
      "claim": "全词纯用白描，语言清丽自然，不事雕琢，情景交融，营造出空灵淡远、清幽静谧的艺术境界。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "以疏淡轻快的笔墨描绘了颍州西湖的暮春景……情景交融，真切动人。词中很少修饰，特别是前后两片，纯用白描，却颇耐寻味。……语言清丽，风格空灵淡远，全词充溢着悠然闲怡之趣。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学可强调该词以简淡笔触传达深远意境，体现宋代文人词重神韵、轻辞藻的审美倾向。",
        "白描手法使景物与情感自然贴合，避免直抒胸臆的刻意。"
      ],
      "forbidden_assertions": [
        "该词大量使用典故、辞藻华丽或属于豪放派风格。",
        "全词情感外露，直白宣泄个人情绪。"
      ]
    },
    {
      "claim_id": "claim_05_lexical_details",
      "claim": "词中“西湖”特指颍州西湖，而非杭州西湖；“狼籍”同“狼藉”，形容残花散乱；“阑干”意为横斜、纵横交错；“帘栊”指窗帘和窗棂。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "西湖：指颍州西湖，在今安徽阜阳西北……狼籍残红：残花纵横散乱的样子……狼籍，同“狼藉”……阑干：横斜，纵横交错。帘栊：窗帘和窗棂，泛指门窗的帘子。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "[西湖]指颍州西湖，在今安徽阜阳县西北……[帘栊]：窗户。栊，窗棂。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“阑干”在此处并非指防护栏杆，而是形容垂柳枝条纵横交错的形态。",
        "“帘栊”在不同注释中可泛指门窗的帘子或特指窗户。"
      ],
      "forbidden_assertions": [
        "词中的“西湖”是指浙江杭州西湖。",
        "“阑干”在词中是指木质或石质的护栏。"
      ]
    }
  ],
