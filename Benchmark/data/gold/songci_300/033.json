{
  "schema_version": "0.2",
  "sample_id": "songci_300_033",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本作为北宋词人柳永所作的慢词，词牌为《雨霖铃》，也写作“雨淋铃”，调见《乐章集》。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "雨霖铃 柳永 宋 词",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "柳永（约984—1053）...北宋著名词人...开创“慢词”长调体裁，代表作《雨霖铃》",
          "locator": "作者简介一",
          "authority": "medium"
        },
        {
          "source_id": "source_note_1",
          "text": "雨霖铃：词牌名，也写作“雨淋铃”，调见《乐章集》。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确该词为宋代婉约派慢词代表作",
        "可指出作者柳永对宋词长调发展有重要贡献"
      ],
      "forbidden_assertions": [
        "该作品为唐代诗歌或豪放派词作",
        "作者为其他宋代词人"
      ]
    },
    {
      "claim_id": "claim_02_background",
      "claim": "此词创作于柳永仕途失意、屡试不第后，离开汴京南下时与恋人惜别之际。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "因作词忤仁宗，屡试不第，所以心中失意忧愤...此词当为柳永从汴京南下时与一位恋人的惜别之作。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "这首词是词人在仕途失意，不得不离京都（汴京，今河南开封）时写的",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "词中离愁与作者个人宦途挫折密切相关",
        "离别地点为北宋都城汴京郊外"
      ],
      "forbidden_assertions": [
        "此词作于作者高中状元或仕途得意之时",
        "离别对象为同僚或友人而非恋人"
      ]
    },
    {
      "claim_id": "claim_03_structure",
      "claim": "全词分上下两阕，上阕实写饯行别情，下阕虚写别后想象，以“念”字实现由实转虚的过渡。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "全词分上下两阕。上阕主要写饯行时难舍难分的惜别场面...下阕着重写想象中别后的凄楚情景。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "从词的结构看,这两句由上阕实写转向下阕虚写，具有承上启下的作用。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“念去去”标志着叙事视角从当下转向未来",
        "词作遵循“先实后虚、情景交融”的章法"
      ],
      "forbidden_assertions": [
        "全词均为实景描写，无想象成分",
        "上下阕之间缺乏逻辑关联或转折"
      ]
    },
    {
      "claim_id": "claim_04_imagery_l07",
      "claim": "“杨柳岸、晓风残月”以景写情，通过谐音与意象组合，深刻传达别后孤寂与难圆之憾。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "“柳”、“留”谐音，写难留的离情；晓风凄冷，写别后的寒心；残月破碎，写此后难圆之意。",
          "locator": "赏析二",
          "authority": "high"
        },
        {
          "source_id": "source_translation_1",
          "text": "怕是只有杨柳岸边，面对凄厉的晨风 and 黎明的残月了。",
          "locator": "译文一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "该句为千古名句，以清冷画面高度浓缩羁旅愁思",
        "景物选择服务于情感表达，非单纯写景"
      ],
      "forbidden_assertions": [
        "该句仅描写春日清晨的明媚风光",
        "意象之间无内在情感逻辑关联"
      ]
    },
    {
      "claim_id": "claim_05_theme_tone",
      "claim": "全词以冷落凄凉的秋景为衬托，交织宦途失意与恋人离别的痛苦，奠定低沉伤感的情感基调。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "词的主要内容是以冷落凄凉的秋景作为衬托来表达和情人难以割舍的离情。宦途的失意 and 与恋人的离别，两种痛苦交织在一起,使词人更加感到前途的暗淡和渺茫。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“清秋节”不仅是时令，更是心理氛围的投射",
        "词作情感具有从个人际遇向普遍离愁升华的特点"
      ],
      "forbidden_assertions": [
        "全词情感基调为欢快明朗或豁达超脱",
        "词中未涉及仕途失意的背景"
      ]
    },
    {
      "claim_id": "claim_06_cipai_origin",
      "claim": "《雨霖铃》曲调相传为唐玄宗入蜀避难时，在雨中听到铃声想起杨贵妃而作，曲调本身即具有哀伤成分。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_note_1",
          "text": "相传唐玄宗入蜀时在雨中听到铃声而想起杨贵妃，故作此曲。曲调自身就具有哀伤的成分。",
          "locator": "注释一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_5",
          "text": "据《明皇杂录》云，安史之乱时，唐玄宗避地蜀中，于栈道雨中闻铃音，起悼念杨贵妃之思，“采其声为《雨霖铃》曲，以寄恨焉”。",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "柳永选用此调，在声情上天然契合其哀怨的离情别绪"
      ],
      "forbidden_assertions": [
        "《雨霖铃》是由柳永完全原创的全新词牌，此前无此曲调"
      ]
    },
    {
      "claim_id": "claim_07_textual_variants",
      "claim": "本词在流传过程中存在多处异文，如“留恋处”一作“方留恋处”，“良辰好景”一作“良辰美景”，“风情”中“情”一作“流”，“更与”中“更”一作“待”。",
      "status": "disputed",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_note_1",
          "text": "留恋处：一作“方留恋处”。良辰好景：一作“良辰美景”。风情：...情：一作“流”。更与：更：一作“待”。",
          "locator": "注释一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "不同版本的异文反映了词作在民间歌伎间口头传唱、流传广泛的特征"
      ],
      "forbidden_assertions": [
        "“方留恋处”和“良辰美景”是现代学者编造的，古代文献中绝无此说"
      ]
    }
  ],
