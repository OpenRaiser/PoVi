{
  "schema_version": "0.2",
  "sample_id": "songci_300_099",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《兰陵王》为北宋词人周邦彦所作，属长调词，词牌为兰陵王，常以“柳”为副题。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：兰陵王 作者：周邦彦 朝代：宋 体裁：词 词牌：兰陵王",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "周邦彦（1056—1121），字美成，号清真居士，钱塘（今浙江杭州）人，北宋著名词人。代表作《兰陵王·柳》",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确其为北宋婉约派长调代表作，作者精通音律且长于铺叙。"
      ],
      "forbidden_assertions": [
        "该词为唐代作品或李白、苏轼等人所作",
        "词牌为《水调歌头》或《念奴娇》"
      ]
    },
    {
      "claim_id": "claim_02_theme",
      "claim": "词作核心为抒发作者离开京华（汴京）时的羁旅离愁与对旧日情人的眷恋，并非单纯咏物或“客中送客”。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "这首词的题目是“柳”，内容却不是咏柳，而是伤别。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_background_2",
          "text": "其实《兰陵王·柳》这首词是周邦彦写自己离开京华时的心情。此时他已倦游京华，却还留恋着那里的情人，回想和她来往的旧事，恋恋不舍地乘船离去。",
          "locator": "创作背景二",
          "authority": "medium"
        },
        {
          "source_id": "source_translation_2",
          "text": "旅居京城使我厌倦，可有谁知道我心中的隐痛？",
          "locator": "译文二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“京华倦客”为作者自指，表达久客思归与离别不舍的矛盾心理。",
        "李师师送别传说虽被辨明为妄，但侧面印证宋代读者将其理解为离京之作。"
      ],
      "forbidden_assertions": [
        "纯为送别友人而作的“客中送客”词",
        "全篇主旨仅为描写柳树形态而无情感寄托"
      ]
    },
    {
      "claim_id": "claim_03_willow_symbol",
      "claim": "词中“柳阴”“柳丝”“柔条”等意象借古人折柳送别习俗，层层渲染离愁别绪与聚散频繁。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "古人有折柳送别之习。柔条，柳枝。过千尺，极言折柳之多。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "古代有折柳的习俗，所以诗词里常用柳来渲染别情。它一上来就写柳阴、写柳丝、写柳絮、写柳条，先将离愁别绪借着渲染了一番。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "柳的形态（直、碧、飘绵）与离别场景交织，暗示时光流逝与别恨绵长。",
        "“应折柔条过千尺”以夸张手法写送别之频，暗含人世聚散无常之叹。"
      ],
      "forbidden_assertions": [
        "柳仅作为自然景物客观描写，无送别文化寓意",
        "“过千尺”为实指物理长度而非虚指折柳数量"
      ]
    },
    {
      "claim_id": "claim_04_structure_time",
      "claim": "全词分三片，时间由正午启程（柳阴直）渐至傍晚（斜阳冉冉），空间由隋堤长亭移至江船别浦，情感随景推移层层递进。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "从词开头的“柳阴直”看来，启程在中午，而这时已到傍晚。“渐”字也表明已经过了一段时间，不是刚刚分别时的情形了。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_translation_2",
          "text": "上片借隋堤柳烘托了离别的气氛，中片便抒写自己的别情。中片写乍别之际，下片写渐远以后。",
          "locator": "译文二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“渐”字为时间与空间转换的枢纽，体现周词结构严谨、长于铺叙的特点。",
        "三片情感由景起兴、至别时追忆、再到渐远孤寂，呈波浪式推进。"
      ],
      "forbidden_assertions": [
        "三片内容跳跃无序，缺乏内在逻辑",
        "全词时间线始终停留在同一时刻或地点"
      ]
    },
    {
      "claim_id": "claim_05_hanshi",
      "claim": "“梨花榆火催寒食”点明饯别时节在寒食清明前后，“催”字暗含岁月匆匆、别期已至的紧迫感。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "饯别时正值梨花盛开的寒食时节。唐宋时期朝廷在清明日取榆柳之火以赐百官，故有“榆火”之说。寒食：清明前一天为寒食。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "“催寒食”的“催”字有岁月匆匆之感。岁月匆匆，别期已至了。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "节令物候与离别情绪相互触发，强化“闲寻旧踪迹”时的心理落差。",
        "“榆火”为唐宋特定礼制，不可泛解为普通炊火。"
      ],
      "forbidden_assertions": [
        "寒食节与离别时间毫无关联",
        "“催”字仅表示节气自然更替，无主观情感色彩"
      ]
    },
    {
      "claim_id": "claim_06_liushishi_legend",
      "claim": "宋代张端义《贵耳集》记载周邦彦因与名妓李师师相好得罪宋徽宗，被押出都门，李师师置酒送别时周邦彦写下此词。但此说在《清真先生遗事》中已被辨明为妄传。",
      "status": "disputed",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "宋张端义《贵耳集》说和名伎李师师相好，得罪了宋徽宗，被押出都门。李师师置酒送别时，周邦彦写了这首词。在《清真先生遗事》中已辨明其妄。",
          "locator": "创作背景一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "虽然李师师送别一说为虚构，但该传说反映了宋代人普遍将此词理解为周邦彦离开京华时的作品。"
      ],
      "forbidden_assertions": [
        "此词确凿是为李师师置酒送别而作",
        "《贵耳集》的记载是毫无争议的历史事实"
      ]
    },
    {
      "claim_id": "claim_07_suidi_meaning",
      "claim": "“隋堤”指汴京附近汴河之堤，为隋炀帝时所建，是北宋来往京城的必经之路。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "隋堤：汴京附近汴河之堤，隋炀帝时所建，故称。是北宋来往京城的必经之路。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "隋堤不仅是地理意象，更是北宋京城送别与行旅的重要文化地标。"
      ],
      "forbidden_assertions": [
        "隋堤是杭州西湖的堤岸",
        "隋堤与北宋京城交通毫无关联"
      ]
    },
    {
      "claim_id": "claim_08_zhouji_view",
      "claim": "清代周济《宋四家词选》认为这首词是“客中送客”，并认为“一愁字代行者设想”；而现代赏析多认为这是作者写自己离开京华时的亲身所见所感。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "周济《宋四家词选》曰：“一愁字代行者设想。”他认定作者是送行的人，所以只好作这样曲折的解释。其实这四句很有实感，应当是作者自己从船上回望岸边的所见所感。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_background_2",
          "text": "自从清代周济《宋四家词选》说这首词是“客中送客”以来，注家多采其说，认为是一首送别词。其实《兰陵王·柳》这首词是周邦彦写自己离开京华时的心情。",
          "locator": "创作背景二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“客中送客”说与“自伤离京”说反映了对词中抒情主体身份的不同理解。"
      ],
      "forbidden_assertions": [
        "周济的“客中送客”说是唯一公认的正确解释",
        "词中“愁”字只能解释为替送行者设想"
      ]
    },
    {
      "claim_id": "claim_09_xun_meaning",
      "claim": "词中“闲寻旧踪迹”的“寻”字并非指在堤上寻找，而是寻思、追忆、回想的意思；“踪迹”指往事。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "那“寻”字，并不是在隋堤上走来走去地寻找。“踪迹”，也不是自己到过的地方。“寻”是寻思、追忆、回想的意思。“踪迹”指往事而言。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "“闲寻”二字表现了船开之后，周围安静下来，词人静下心来回忆京华往事的心理状态。"
      ],
      "forbidden_assertions": [
        "“寻”字是实指在隋堤上步行寻找遗失的物品",
        "“踪迹”仅指作者曾经物理到达过的具体地理位置"
      ]
    }
  ],
