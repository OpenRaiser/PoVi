  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "本词《六州歌头》为南宋豪放派词人张孝祥于隆兴二年（1164年）任建康留守时所作。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：六州歌头 作者：张孝祥 朝代：宋 体裁：词",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_background_2",
          "text": "《六州歌头·长淮望断》这首词作于宋孝宗隆兴二年（1164年）。当时张孝祥任建康留守，在一次宴会上，写下了这首著名的词作。",
          "locator": "创作背景二",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "张孝祥（1132—1169）……南宋著名词人。其词风格豪放，境界阔大，情感激昂，多抒发爱国情怀，上承苏轼，下启辛弃疾，是豪放词派的重要代表。",
          "locator": "作者简介一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确该词为南宋爱国豪放词代表作",
        "可指出作者创作时身处抗金前线（建康）的特定身份"
      ],
      "forbidden_assertions": [
        "该词为北宋作品",
        "作者为婉约派词人",
        "创作时间早于隆兴元年"
      ]
    },
    {
      "claim_id": "claim_02_historical",
      "claim": "隆兴元年北伐军在符离溃败后，主和派撤尽淮河边防并向金乞和，淮河成为宋金实际分界线。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "隆兴元年（1163年），张浚领导的南宋北伐军在符离（今安徽宿县北）溃败，主和派得势，将淮河前线边防撤尽，向金国遣使乞和。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_1",
          "text": "长淮：指淮河。宋高宗绍兴十年来（公元1141年）与金和议，以淮河为宋金的分界线。此句即远望边界之意。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "淮河从内河变为国境线是词人悲愤的直接地理与政治诱因",
        "边防撤尽导致关塞荒废、敌骑可乘"
      ],
      "forbidden_assertions": [
        "淮河在北宋时期即为宋金边界",
        "北伐军取得了符离大捷",
        "主战派主导了当时的朝廷决策"
      ]
    },
    {
      "claim_id": "claim_03_upper_scene",
      "claim": "上阕通过长淮荒草、隔岸毡乡、落日牛羊与夜间骑火笳鼓，描绘边境荒凉与金人活动威势，暗含对边防松弛的忧愤。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "上阕，描写江淮区域宋金对峙的态势。……极目千里淮河，南岸一线的防御无屏障可守，只是莽莽平野而已。江淮之间，征尘暗淡，霜风凄紧，更增战后的荒凉景象。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_notes_1",
          "text": "关塞莽然平：草木茂盛，齐及关塞。谓边备松驰。……隔水毡乡，落日牛羊下，区脱纵横。……看名王宵猎，骑火一川明，笳鼓悲鸣，遣人惊。",
          "locator": "注释一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "景物描写并非纯写景，而是服务于政治军事形势的暗示",
        "金人宵猎的喧闹反衬宋军防线的沉寂与空虚"
      ],
      "forbidden_assertions": [
        "上阕纯粹描写自然风光与田园牧歌",
        "金人活动仅限于和平贸易",
        "边塞草木茂盛代表国防巩固"
      ]
    },
    {
      "claim_id": "claim_04_lower_emotion",
      "claim": "下阕以“腰间箭，匣中剑”起笔，直斥朝廷“干羽方怀远”的求和苟安，并写中原遗老南望王师的悲愤与忠愤填膺。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "下阕，抒写复国的壮志难酬，朝延当政者苟安于和议现状，中原人民空盼光复，词情更加悲壮。……“干羽方怀远”活用《尚书·大禹谟》……词人借以辛辣地讽刺朝廷放弃失地，安于现状。……“闻道”两句写金人统治下的父老同胞，年年盼望王师早日北伐收复天地。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_translation_2",
          "text": "想我腰间弓箭，匣中宝剑，空自遭了虫尘埃的侵蚀和污染，满怀壮志竟不得施展。……冠服乘车的使者，纷纷地奔驰匆匆，实在让人羞愧难以为情。传说留下中原的父老，常常盼望朝廷……一腔忠愤，怒气填膺，热泪倾洒前胸。",
          "locator": "译文二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "个人报国无门的苦闷与朝廷政策失误形成强烈共振",
        "遗老的期盼与使者的屈辱构成尖锐的朝野/敌我矛盾"
      ],
      "forbidden_assertions": [
        "词人赞同朝廷的怀柔政策",
        "中原遗老已放弃对南宋的期望",
        "下阕情绪转为闲适恬淡"
      ]
    },
    {
      "claim_id": "claim_05_metaphor_ganyu",
      "claim": "“干羽”本为古代乐舞道具，此处借代朝廷放弃武备、以文德怀柔求和的妥协政策。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "干羽方怀远：用文德以怀柔远人，谓朝廷正在向敌人求和。干羽，干盾和翟羽，都是舞蹈乐具。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "干羽方怀远：用文德以怀柔远人，谓朝廷正在向敌人求和。干羽，干盾和翟羽，都是舞蹈乐具。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "典故反用，以文德之名行苟安之实，具强烈讽刺意味",
        "可联系《尚书》原典对比理解词人的批判立场"
      ],
      "forbidden_assertions": [
        "干羽指代实际的军事武器",
        "朝廷真正以德服人、实现和平",
        "该词为赞美朝廷外交成就之作"
      ]
    },
    {
      "claim_id": "claim_06_metaphor_cuibaoni",
      "claim": "“翠葆霓旌”指以翠鸟羽毛为饰的车盖与彩旗，借指宋朝皇帝的仪仗或北伐王师。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "翠葆霓旌：指皇帝的仪仗。翠葆，以翠鸟羽毛为饰的车盖。霓旌，像虹霓似的彩色旌旗。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "“翠葆霓旌”，即饰以鸟羽的车盖和彩旗，是皇帝的仪仗，这里借指宋帝车驾。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "仪仗象征国家正统与收复失地的希望",
        "遗老“南望”实为期盼王师北定中原"
      ],
      "forbidden_assertions": [
        "翠葆霓旌指金国贵族的车马",
        "仅为普通节日装饰，无政治象征",
        "遗老盼望的是金朝统治者的巡幸"
      ]
    },
    {
      "claim_id": "claim_07_structure",
      "claim": "全词多用三、四言短句，节奏急促激越，通过多层次对比展现时代画卷，被评具有“词史”价值。",
      "status": "licensed_interpretation",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "《六州歌头》篇幅长，格局阔大。多用三言、四言的短句，构成激越紧张的促节，声情激壮……多层次、多角度地展示了那个时代的宏观历史画卷，强有力地表达出人民的心声。就像杜甫诗历来被称为诗史一样，这首《六州歌头》，也完全可以被称为词史。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "短句形式与抗金救亡的紧迫感高度契合",
        "词作具有记录时代动荡与民心向背的文献价值"
      ],
      "forbidden_assertions": [
        "该词以长句为主，节奏舒缓",
        "词作仅抒发个人闲愁，无历史厚度",
        "声情激壮与句式长短无关"
      ]
    },
    {
      "claim_id": "claim_08_lexical_zhusi",
      "claim": "“洙泗”指鲁国洙水和泗水，流经曲阜，是孔子当年讲学的地方，此处代指中原礼乐文化之邦。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_2",
          "text": "洙、泗：鲁国二水名，流经曲阜（春秋时鲁国国都），孔子曾在此讲学。弦歌地：指礼乐文化之邦。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "洙泗沦为“膻腥”之地，象征着华夏文化正统遭受异族践踏，加深了词人的文化悲剧感"
      ],
      "forbidden_assertions": [
        "洙泗是金国境内的河流名",
        "洙泗在词中仅指代普通的自然山水"
      ]
    },
    {
      "claim_id": "claim_09_lexical_qutuo",
      "claim": "“区脱”为匈奴语，指边境屯戍或守望之处的土堡。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_2",
          "text": "区（ōu）脱纵横：土堡很多。区脱，匈奴语称边境屯戍或守望之处。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“区脱纵横”表明金兵在边境设防严密，对南宋构成直接的军事威胁"
      ],
      "forbidden_assertions": [
        "区脱是指金国游牧的牛羊群",
        "区脱是宋军修筑的防御工事"
      ]
    },
    {
      "claim_id": "claim_10_alternative_reading_baobao",
      "claim": "关于“翠葆霓旌”一句，原文版本二作“羽葆霓旌”，存在异文现象。",
      "status": "disputed",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_version_2",
          "text": "闻道中原遗老，常南望，羽葆霓旌。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_version_1",
          "text": "闻道中原遗老，常南望，翠葆霓旌。",
          "locator": "原文版本一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“羽葆”与“翠葆”均指饰以鸟羽的皇家仪仗车盖，字面虽异但核心意象与政治寄托一致"
      ],
      "forbidden_assertions": [
