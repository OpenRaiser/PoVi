  "key_events": [
    {
      "event_id": "evt_157_01",
      "description": "靖康二年（1127年）中原沦陷，至绍兴十一年（1141年）宋金达成和议，划淮河中流为界，形成南北长期对峙的局面。",
      "audio_triggers": [
        "靖康之变",
        "中原沦陷",
        "绍兴十一年",
        "以淮河为界"
      ],
      "visual_evidence": [
        "宋金交战画面，金兵铁骑南下，中原大地图上划出淮河为宋金交界线，孔子故里（洙泗）等地竖起金国旗帜，牧民与牛羊在旧日农耕区出现。"
      ],
      "sound_evidence": [
        "金戈铁马的交战声",
        "凄凉的胡笳声",
        "牛羊的叫声"
      ],
      "tolerance_seconds": 2,
      "importance": 3
    },
    {
      "event_id": "evt_157_02",
      "description": "隆兴元年（1163年），张浚领导的南宋北伐军在符离溃败，朝廷内部主和派得势，将淮河前线的边防全部撤除，并向金国遣使乞和。",
      "audio_triggers": [
        "隆兴元年",
        "符离溃败",
        "主和派得势",
        "遣使乞和"
      ],
      "visual_evidence": [
        "南宋军队溃退的场景，朝廷内主和派官员占据上风，前线关塞杂草丛生、防备撤尽，南宋使臣车队（冠盖）匆匆奔赴北方求和。"
      ],
      "sound_evidence": [
        "大军溃散的脚步声",
        "朝堂上的争辩声"
      ],
      "importance": 3
    },
    {
      "event_id": "evt_157_03",
      "description": "隆兴二年（1164年），张孝祥担任建康（今南京）留守。他眼见边备空虚，宝剑与弓箭只能生锈虫蛀，面对朝廷投降媚敌的行径深感屈辱与痛心。",
      "audio_triggers": [
        "担任建康留守",
        "边备空虚",
        "报国无门"
      ],
      "visual_evidence": [
        "南宋建康城的官署内，张孝祥身穿宋代官服，看着匣中生锈的宝剑和尘封的弓箭，神情黯然，望向北方。"
      ],
      "sound_evidence": [
        "拔出锈剑的摩擦声",
        "长叹声"
      ],
      "importance": 2
    },
    {
      "event_id": "evt_157_04",
      "description": "通常认为，张浚在建康召集抗金义士，拟上书宋孝宗反对议和，张孝祥也参与了此次抗议集会。",
      "audio_triggers": [
        "张浚",
        "召集抗金义士",
        "反对议和"
      ],
      "visual_evidence": [
        "张浚与众抗金志士在建康密会，众人表情激愤，共同商讨拟写反对议和的奏疏。"
      ],
      "importance": 2
    },
    {
      "event_id": "evt_157_05",
      "description": "在建康的一次宴席上，张孝祥为山河破碎、中原遗老苦盼王师而悲愤，即席挥毫写下《六州歌头》。据传其慷慨悲壮之情令张浚感动得罢席而入。",
      "audio_triggers": [
        "一次宴会上",
        "即席挥毫",
        "罢席而入",
        "写下了这首"
      ],
      "visual_evidence": [
        "宴会场景，张孝祥在案前奋笔疾书，满脸悲愤；同席的张浚（魏公）深受震撼，起身离席退入内室。禁止出现明清家具和服饰。"
      ],
      "sound_evidence": [
        "激昂悲壮的背景音乐",
        "笔墨摩擦纸张的声音",
        "推开座椅起身的动作声"
      ],
      "tolerance_seconds": 1,
      "importance": 3
    }
  ],
