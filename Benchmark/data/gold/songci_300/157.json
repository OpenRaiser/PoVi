      ],
      "source_domain": [
        "干羽"
      ],
      "target_domain": [
        "朝廷放弃武备、以文德怀柔求和的妥协政策"
      ],
      "bridges": [
        "干羽本为古代文舞道具，词人反用《尚书》典故，以礼乐之名讽刺朝廷苟安求和、放弃失地的现实"
      ],
      "context_claim_ids": [
        "claim_05_metaphor_ganyu"
      ],
      "status": "consensus",
      "alternative_readings": [
        "可理解为对朝廷粉饰太平、以文化外交掩盖军事软弱的政治符号反讽",
        "亦可视作对儒家“修文德以来之”理想在现实政治中异化的批判"
      ],
      "importance": 2
    },
    {
      "metaphor_id": "meta_02_cuibaoni",
      "line_ids": [
        "l10"
      ],
      "source_domain": [
