      "target_domain": [
        "宋朝皇帝车驾或北伐王师"
      ],
      "bridges": [
        "翠鸟羽饰车盖与虹霓彩旗为皇家仪仗典型特征，借指遗老日夜期盼的朝廷军队与国家正统象征"
      ],
      "context_claim_ids": [
        "claim_06_metaphor_cuibaoni"
      ],
      "status": "consensus",
      "alternative_readings": [
        "可具体指代宋帝巡幸仪仗，象征收复失地的希望与民心所向",
        "亦可视为一种精神图腾，代表沦陷区百姓对故国法统的坚守"
      ],
      "importance": 2
    },
    {
