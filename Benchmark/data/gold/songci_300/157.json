      ]
    },
    {
      "claim_id": "claim_11_historical_zhangjun",
      "claim": "隆兴元年北伐失败后，张浚曾召集抗金义士于建康，拟上书宋孝宗反对议和，张孝祥当时任建康留守并参与了相关宴会。",
      "status": "documented",
      "importance": 2,
      "evidence": [
