{
  "schema_version": "0.2",
  "sample_id": "tangshi_300_297",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《赤壁》是唐代诗人杜牧创作的一首七言绝句。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "题名：赤壁；作者：杜牧；朝代：唐；体裁：七言绝句",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "杜牧（803—852），字牧之，号樊川居士，晚唐著名诗人、文学家...尤擅七绝与咏史诗",
          "locator": "作者简介一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可明确标注该诗为晚唐咏史七绝代表作",
        "作者杜牧与李商隐并称'小李杜'"
      ],
      "forbidden_assertions": [
        "该诗为五言律诗",
        "作者为杜甫或李白"
      ]
    },
    {
      "claim_id": "claim_02_historical_context",
      "claim": "诗歌核心涉及建安十三年（208年）十月的赤壁之战，周瑜借东风火攻曹军，以及曹操所建铜雀台与东吴二乔的典故。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "东风：指火烧赤壁事。周郎：即周瑜...曾利用东风之势火烧赤壁。铜雀：即铜雀台。曹操建于邺城。二乔：即江东乔公的两个女儿...大乔嫁孙策，小乔嫁周瑜。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "发生于汉献帝建安十三年（208年）十月的赤壁之战...三十四岁的孙吴军统帅周瑜，乃是这次战役中的头号风云人物。",
          "locator": "创作背景一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "诗中'前朝'指三国时期",
        "'东风'特指赤壁之战中助周瑜火攻的自然条件"
      ],
      "forbidden_assertions": [
        "赤壁之战发生在唐代",
        "二乔是曹操的女儿"
      ]
    },
    {
      "claim_id": "claim_03_structure",
      "claim": "诗歌前两句（l01）以发现古战场遗物'折戟'起兴，后两句（l02）通过假设历史转折（东风不与周郎便）引发对战争结局的逆向推演。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "诗篇的开头借一件古物兴起对前朝人、事、物的慨叹...为后文抒怀作了很好的铺垫。",
          "locator": "赏析一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "可此处作者进行了逆向思维大胆地设想，提出了一个与历史事实相反的假设。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "前实后虚，由物及史，由史及论",
        "后两句构成条件复句的假设关系"
      ],
      "forbidden_assertions": [
        "全诗为纯写景诗",
        "前后两句无逻辑关联"
      ]
    },
    {
      "claim_id": "claim_04_interpretive_theme",
      "claim": "诗人借赤壁之战的偶然性（东风），抒发对历史成败的感慨，并暗含自身怀才不遇、渴望机遇的抑郁之情。",
      "status": "licensed_interpretation",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_3",
          "text": "借慨叹周瑜因有东风之便取得成功，抒发自己怀才不遇的心情。",
          "locator": "赏析三",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_4",
          "text": "实际上，诗人作此诗并非是为了咏史论史，更主要的是以史喻今，抒发情感...表达了自己心中的抑郁不平和渴望得到重用、有所作为的情感。",
          "locator": "赏析四",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "诗歌具有咏史抒怀的双重性质",
        "'东风'可解读为历史机遇的象征"
      ],
      "forbidden_assertions": [
        "诗歌纯粹客观记录历史",
        "作者对周瑜持完全否定态度"
      ]
    },
    {
      "claim_id": "claim_05_lexical_details",
      "claim": "诗中“折戟”指折断的兵器戟；“销”指销蚀；“将”指拿、取；“磨洗”指磨光洗净；“前朝”指赤壁之战的时代（三国东吴破曹时期）。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1_lex",
          "text": "折戟：折断的戟。戟：古代兵器。销：销蚀。将：拿，取。磨洗：磨光洗净。认前朝：辨认出是前朝遗物。前朝：这里指赤壁之战的时代。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2_lex",
          "text": "认前朝：认出戟是东吴破曹时的遗物。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“自将磨洗”说明诗人亲自参与了对文物的清理和辨认"
      ],
      "forbidden_assertions": [
        "“将”在诗中是“将要”的意思",
        "“前朝”指唐朝之前的隋朝"
      ]
    },
    {
      "claim_id": "claim_06_bronze_bird_details",
      "claim": "“铜雀”指铜雀台，是曹操在邺城（今河北临漳西）建造的一座楼台，楼顶铸有大铜雀，台上住姬妾歌妓，是曹操暮年行乐处。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1_bronze",
          "text": "铜雀：即铜雀台。曹操建于邺城 （今河北临漳西），因楼顶铸有大铜雀而得名。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2_bronze",
          "text": "铜雀：即铜雀台，曹操在今河北省临漳县建造的一座楼台，楼顶里有大铜雀，台上住姬妾歌妓，是曹操暮年行乐处。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "铜雀台在诗中代表了曹操胜利后享乐的象征"
      ],
      "forbidden_assertions": [
        "铜雀台是周瑜建造的建筑",
        "铜雀台位于东吴境内"
      ]
    },
    {
      "claim_id": "claim_07_creation_background",
      "claim": "《赤壁》作于会昌二年（842年）杜牧任黄州刺史期间，时年40岁的诗人登临赤壁古战场（今湖北省武昌县西南赤矶山或蒲圻西北）有感而作。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_2_detail",
          "text": "《赤壁》此诗作于会昌二年（842年）杜牧任黄州刺史期间，时年40岁的诗人登临赤壁古战场而作。",
          "locator": "创作背景二",
          "authority": "high"
        },
        {
          "source_id": "source_background_1_detail",
          "text": "这首诗是诗人经过赤壁（今湖北省武昌县西南赤矶山）这个著名的古战场，有感于三国时代的英雄成败而写下的。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1_loc",
          "text": "“赤壁”，山名，在今湖北蒲圻西北，长江南岸，对岸为乌林",
          "locator": "赏析一",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "杜牧在黄州任职期间通过游历古战场触发了创作灵感"
      ],
      "forbidden_assertions": [
        "此诗作于杜牧晚年居住在长安樊川别墅时期",
        "杜牧创作此诗时正值赤壁之战发生当年"
      ]
    },
    {
      "claim_id": "claim_08_grammar_hypothesis",
      "claim": "“东风不与周郎便”在唐诗语法中表达假定语气，即“倘若当年东风不帮助周瑜的话”。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_3_grammar",
          "text": "“东风不与周郎便”，从散文语法规律看，这是一种肯定语气...但在唐诗中，它可以表达为假定语气。",
          "locator": "赏析三",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2_grammar",
          "text": "意为倘若当年东风不帮助周瑜的话，那么铜雀台就会深深地锁住东吴二乔了。",
          "locator": "赏析二",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "唐代诗歌为了精炼，常常省略“如果”、“倘若”等假设关联词"
      ],
      "forbidden_assertions": [
        "此句在诗中是肯定语气，意为东风确实没有给周瑜方便"
      ]
    }
  ],
