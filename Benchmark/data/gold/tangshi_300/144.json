  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_poem_identity",
      "claim": "《春望》是唐代诗人杜甫创作的五言律诗，属于杜甫现实主义诗歌的经典代表作，被后世尊为“诗史”的典型代表。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "春望 杜甫 唐 五言律诗",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "杜甫代表作有《春望》等，风格沉郁顿挫",
          "locator": "作者简介一",
          "authority": "high"
        },
        {
          "source_id": "source_background_2",
          "text": "作品诞生于盛唐文明遭遇毁灭性打击的历史节点，其个人命运与家国情怀的高度统一，标志着中国诗歌史上现实主义创作的高峰，成为记录时代苦难的\"诗史\"。",
          "locator": "创作背景二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可明确将《春望》归为杜甫安史之乱时期的经典现实主义作品"
      ],
      "forbidden_assertions": [
        "声称《春望》作者为李白或其他唐代诗人",
        "将体裁判定为七言律诗或绝句"
      ]
    },
    {
      "claim_id": "claim_02_creation_context",
      "claim": "《春望》作于唐肃宗至德二载（757年）三月，当时杜甫身陷被安史叛军占领的长安，目睹国都残破景象百感交集而创作此诗。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "此诗作于肃宗至德二载（757年）三月，杜甫被俘押送到沦陷后的长安已逾半载，暮春之际创作",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_4",
          "text": "这首五言律诗作于唐肃宗至德二年（757），当时安禄山和史思明起兵反唐，攻下京都长安，杜甫被叛军俘虏困居长安",
          "locator": "赏析四",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可将本诗作为安史之乱时期记录时代苦难的代表性作品引入教学"
      ],
      "forbidden_assertions": [
        "声称本诗作于安史之乱爆发之前",
        "声称本诗是杜甫定居蜀地之后的作品"
      ]
    },
    {
      "claim_id": "claim_03_core_lexical_definition",
      "claim": "诗中核心字词有明确释义：国指被叛军占领的国都长安，破指陷落，烽火借指战事，抵指值、相当，浑指简直，簪是古代男子束发的首饰。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "国：国都，指长安，破：陷落，烽火：古时边防报警的烟火，这里借指战事，抵：值，相当，浑：简直，簪：一种别住发髻的长条状首饰",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "胜：受不住，不能，簪：一种束发的首饰，古代男子蓄长发，成年后束发于头顶，用簪子横插住",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可结合唐代男子束发的习俗解释“不胜簪”的细节"
      ],
      "forbidden_assertions": [
        "将“烽火”直接解释为普通的烟火",
        "将“国”泛泛解释为整个唐朝疆域"
      ]
    },
    {
      "claim_id": "claim_04_structure_and_theme",
      "claim": "全诗围绕“望”字展开，前四句写春日长安凄惨破败的景象，饱含兴衰感慨，后四句抒发诗人挂念亲人、心系国事的情怀，充溢凄苦哀思，情景交融，体现杜甫沉郁顿挫的典型风格。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "此诗前四句写春日长安凄惨破败的景象，饱含着兴衰感慨；后四句写诗人挂念亲人、心系国事的情怀，充溢着凄苦哀思，全诗格律严整",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "这首诗全篇情景交融，感情深沉，围绕“望”字展开，环环相生、层层递进，充分体现了“沉郁顿挫”的艺术风格",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可梳理本诗由远及近、由景入情的叙事抒情逻辑"
      ],
      "forbidden_assertions": [
        "声称本诗的核心主题是赞美长安春日美景"
      ]
    },
    {
      "claim_id": "claim_05_artistic_expression",
      "claim": "颔联“感时花溅泪，恨别鸟惊心”采用移情于物、以乐景写哀情的艺术手法，将诗人自身的家国悲愁投射到花鸟意象之上，强化了哀痛的表达效果。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "人内心痛苦，遇到乐景，反而引发更多的痛苦，杜甫继承了这种以乐景表现哀情的艺术手法，这联通过景物描写，借景生情，移情于物",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可对比《诗经·采薇》“昔我往矣，杨柳依依”的同类手法进行拓展讲解"
      ],
      "forbidden_assertions": [
        "声称诗句描写的是花鸟本身在战乱中受惊落泪的客观场景"
      ]
    },
    {
      "claim_id": "claim_06_lexical_details",
      "claim": "诗中“感时”指为国家的时局而感伤，“恨别”指怅恨离别，“不胜”指不能承受、禁不起，“草木深”指人烟稀少、荒芜破败。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "感时：为国家的时局而感伤。恨别：怅恨离别。草木深：指人烟稀少。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "胜：受不住，不能。",
          "locator": "注释二",
          "authority": "high"
        },
        {
          "source_id": "source_notes_3",
          "text": "不胜：不能承受。",
          "locator": "注释三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“草木深”在诗中并非赞美春意盎然，而是反衬战乱后城市的荒凉"
      ],
      "forbidden_assertions": [
        "将“草木深”解释为城市绿化建设良好"
      ]
    },
    {
      "claim_id": "claim_07_historical_details",
      "claim": "杜甫在写此诗前，于至德元载（756年）八月将家属安顿在鄜州羌村，只身投奔肃宗朝廷途中被叛军俘获，解送至长安，因官职卑微未被囚禁，至写诗时已被困长安半年多。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "先一年八月，将妻子安置在鄜州羌村，于北赴灵武途中被俘，押送到沦陷后的长安，至此已逾半载。",
          "locator": "创作背景一",
          "authority": "high"
        },
        {
          "source_id": "source_background_3",
          "text": "即将家属安顿在都州，只身一人投奔肃宗朝廷，结果不幸在途中被叛军俘获，解送至长安，后因官职卑微才未被囚禁。",
          "locator": "创作背景三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "杜甫在长安虽未被囚禁，但行动和消息传递仍深受战乱阻碍"
      ],
      "forbidden_assertions": [
        "声称杜甫在长安期间被关押在监狱中"
      ]
    },
    {
      "claim_id": "claim_08_empathy_disputed",
      "claim": "关于“感时花溅泪，恨别鸟惊心”的理解存在两说：一说为移情于物，花鸟因人而具有了怨恨之情；另一说为诗人感时恨别，看到花开而流泪，听到鸟鸣而心惊。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "花无情而有泪，鸟无恨而惊心，花鸟是因人而具有了怨恨之情。...这两句的含意可以这样理解：我感于战败的时局，看到花开而泪落潸然；我内心惆怅怨恨，听到鸟鸣而心惊胆战。",
          "locator": "赏析二",
          "authority": "medium"
        },
        {
          "source_id": "source_translation_3",
          "text": "感伤国事，不禁涕泪四溅，鸟鸣惊心，徒增离愁别恨。",
          "locator": "译文三",
          "authority": "medium"
        }
      ],
      "acceptable_inferences": [
        "两种解读均能体现诗人在战乱中极度悲痛、敏感的心境"
      ],
      "forbidden_assertions": [
        "断言该句只有一种绝对正确的标准解释"
      ]
    }
  ],
