  "metaphor_maps": [
    {
      "metaphor_id": "meta_01_fire_punishment",
      "line_ids": [
        "l09"
      ],
      "source_domain": [
        "火烧、油煎的极端酷刑"
      ],
      "target_domain": [
        "官吏横征暴敛给百姓带来的走投无路的生存压迫"
      ],
      "bridges": [
        "火烧油煎会给人带来无法忍受的极端痛苦，和百姓被重税逼迫、朝不保夕的生存状态高度相似",
        "该比喻承接前文“日晏犹得眠”的太平状态，形成强烈的苦乐反差"
      ],
      "context_claim_ids": [
        "claim_04_fire_metaphor"
      ],
      "status": "consensus",
      "alternative_readings": [
        "也可解读为诗人目睹百姓惨状后内心愤急情绪的外化，用火烧油煎形容自己的焦灼与愤怒"
      ],
      "importance": 3
    },
    {
      "metaphor_id": "meta_02_symbol_official_post",
      "line_ids": [
        "l11"
      ],
      "source_domain": [
        "朝廷颁发的用于传达命令、征调兵将的符节凭证"
      ],
      "target_domain": [
        "元结所担任的道州刺史的官职与行政权力"
      ],
      "bridges": [
        "符节是古代官员行使官方权力的核心凭证，丢弃符节就代表主动放弃所有公职身份与权力",
        "用具体的物品代指抽象的官职，符合古典诗歌常用的借代表达习惯"
      ],
      "context_claim_ids": [
        "claim_05_author_position",
        "claim_06_lexical_definition"
      ],
      "status": "consensus",
      "alternative_readings": [
        "符节也可泛指所有朝廷授予的官吏身份，“委符节”代表彻底与残民的官僚体系切割"
      ],
      "importance": 2
    },
    {
      "metaphor_id": "meta_03_symbol_retreat",
      "line_ids": [
        "l11"
      ],
      "source_domain": [
        "引竿（拿钓竿）"
      ],
      "target_domain": [
        "隐居生活"
      ],
      "bridges": [
        "拿钓竿垂钓是古代隐士的典型生活方式，因此“引竿”常作为隐居的代称"
      ],
      "context_claim_ids": [
        "claim_05_author_position",
        "claim_06_lexical_definition"
      ],
      "status": "consensus",
      "alternative_readings": [],
      "importance": 2
    }
  ],
  "visual_requirements": [
    {
      "requirement_id": "vis_01_opening_poem_intro",
      "description": "视频开场清晰呈现诗题、作者、朝代信息，同步展示完整无错的全诗文本，配合朗读逐句弹出字幕。",
      "acceptable_realizations": [
        "古风题签样式展示诗题作者，旁白朗读时逐行高亮对应诗句",
        "背景搭配唐代道州山水的古地图作为底衬"
      ],
      "forbidden_realizations": [
        "出现错字漏句，擅自修改原诗文本内容",
        "遗漏作者、朝代等核心元信息"
      ],
      "importance": 3,
      "required_visibility": true,
      "metaphor_ids": [],
      "expected_phase": "opening_poem_presentation",
      "semantic_role": "opening_poem_presentation"
    },
    {
      "requirement_id": "vis_02_recall_peaceful_life",
      "description": "对应诗歌第一段内容，展示安史之乱前太平年间，诗人隐居山林、百姓安居乐业的祥和画面。",
      "acceptable_realizations": [
        "画面呈现山泉水流经庭院，百姓日出而作日落而息的田园场景",
        "搭配舒缓的传统民乐烘托太平氛围"
      ],
      "forbidden_realizations": [
        "在该段落提前出现战乱、兵戈等破坏祥和氛围的元素",
        "将太平场景设置为都市繁华的宫廷环境"
      ],
      "importance": 2,
      "required_visibility": true,
      "metaphor_ids": [],
      "expected_phase": "recall_prewar_peace",
      "semantic_role": "recall_prewar_peace"
    },
    {
      "requirement_id": "vis_03_depict_war_turmoil",
      "description": "对应诗歌第二段内容，展示安史之乱、西原贼乱后道州城残破、百姓流离失所的战后景象。",
      "acceptable_realizations": [
        "画面呈现被焚毁的房屋、荒芜的田地，百姓面有菜色的萧条场景",
        "穿插西原贼攻破邻州却绕过道州的叙事画面"
      ],
      "forbidden_realizations": [
        "刻意美化贼乱的暴行，将贼军塑造为救民于水火的正义军队",
        "完全不展示战后道州的残破景象"
      ],
      "importance": 3,
      "required_visibility": true,
      "metaphor_ids": [],
      "expected_phase": "depict_postwar_misery",
      "semantic_role": "depict_postwar_misery"
    },
    {
      "requirement_id": "vis_04_condemn_cruel_exploitation",
      "description": "对应诗歌第三段内容，展示官吏手持文书催逼赋税，百姓被逼得走投无路的画面，突出“迫之如火煎”的火烧意象。",
      "acceptable_realizations": [
        "画面中用隐约的火焰光晕笼罩被催逼的百姓，直观呈现如火煎烤的压迫感",
        "用官吏和贼的行为对比分屏展示，凸显“吏不如贼”的批判主题"
      ],
      "forbidden_realizations": [
        "将征敛官吏塑造为勤政爱民的正面形象",
        "完全不体现“如火煎”的核心比喻视觉元素"
      ],
      "importance": 3,
      "required_visibility": true,
      "metaphor_ids": [
        "meta_01_fire_punishment"
      ],
      "expected_phase": "condemn_corrupt_exploitation",
      "semantic_role": "condemn_corrupt_exploitation"
    },
    {
      "requirement_id": "vis_05_show_retreat_aspiration",
      "description": "对应诗歌第四段内容，展示元结丢弃符节，手持竹篙撑船，携全家向山水深处行去的归隐画面。",
      "acceptable_realizations": [
        "画面中符节被轻轻放在岸边的石头上，诗人手持钓竿或竹篙，乘船逐渐驶向开阔的江面",
        "背景是开阔的湖光山色，烘托诗人远离官场的释然心境"
      ],
      "forbidden_realizations": [
        "将诗人归隐的画面设置为返回繁华的京城继续做官",
