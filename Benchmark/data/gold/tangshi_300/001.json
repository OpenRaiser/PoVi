      ],
      "importance": 2,
      "required_visibility": true,
      "metaphor_ids": [
        "meta_02_symbol_official_post",
        "meta_03_symbol_retreat"
      ],
      "expected_phase": "express_retreat_resolution",
      "semantic_role": "express_retreat_resolution"
    }
