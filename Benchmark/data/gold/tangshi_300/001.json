  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《贼退示官吏》是唐代诗人元结创作的五言古诗，属于元结反映社会现实、同情民生疾苦的代表性作品。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "昔岁逢太平，山林二十年。",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "元结（719—772），唐代文学家。曾任道州刺史等职。为官清廉体恤民瘼，反对绮靡文风，主张诗歌应“救时劝俗”。其诗注重反映现实",
          "locator": "作者简介一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_1",
          "text": "此诗和《舂陵行》都是作者反映社会现实，同情人民疾苦的代表作",
          "locator": "赏析一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可将本诗作为元结现实主义创作风格的典型案例讲解",
        "可关联新乐府运动先驱的创作定位介绍作品价值"
      ],
      "forbidden_assertions": [
        "将本诗归为其他朝代作者的作品",
        "将本诗体裁误判为七言律诗或绝句"
      ]
    },
    {
      "claim_id": "claim_02_creation_context",
      "claim": "本诗作于唐代宗广德二年（764年），元结时任道州刺史。癸卯岁（763年）西原贼攻入道州焚烧杀掠，次年贼又攻破永、邵二州，却因哀怜道州百姓贫穷而未侵犯道州边境。而朝廷派来的征敛官吏仍不顾百姓死活横征暴敛，故作此诗警示官吏。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_background_1",
          "text": "此诗作于唐代宗广德二年（764年），时元结任道州刺史。此诗的小序交待了作诗的原委。……作者写下了这首诗以警示征敛租税的官吏。",
          "locator": "创作背景二",
          "authority": "high"
        },
        {
          "source_id": "source_original_2",
          "text": "癸卯岁，西原贼入道县，焚烧杀掠，几尽而去。明年，贼又攻永破邵，不犯此州边鄙而退。岂力能制敌与？盖蒙其伤怜而已。诸使何为忍苦征敛，故作诗一篇以示官吏。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_background_3",
          "text": "癸卯年十二月，广西境内被称作“西原蛮”的一群强盗发动了武装暴乱，曾攻占道州（州治在今湖南道县）达一月余……第二年五月，元结任道州刺史，七月“西原蛮”又攻破了邻近的永州和邵州，却没有再攻道州。诗人认为，这并不是官府“力能制敌”，而是出于“西原蛮”对战乱中道州人民的“伤怜”",
          "locator": "创作背景三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可结合元结同期作品《舂陵行》中百姓食不果腹的背景补充讲解民生惨状",
        "可说明诗中称起义民众为“贼”是作者所处时代的历史局限性"
      ],
      "forbidden_assertions": [
        "声称本诗创作目的是歌颂朝廷官吏的治理功绩",
        "否定西原贼乱中道州百姓因贫困免遭二次屠戮的史实基础"
      ]
    },
    {
      "claim_id": "claim_03_text_structure",
      "claim": "全诗可分为四个逻辑层次：第一段（l01-l03）追忆安史之乱前的太平隐居生活，第二段（l04-l07）叙述贼乱中道州得以保全的经过，第三段（l08-l10）斥责征敛官吏比贼还残暴的恶行，第四段（l11-l12）表明作者宁可弃官归隐也不愿残害百姓的心志。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "全诗共分四段。第一段由“昔年”句至“日晏”句，先写“昔”……第二段从“忽然”句到“此州”句，写“今”，写“贼”……第三段从“使臣”句至“以作”句，写“今”，写“官”……第四段由“思欲”句至“归老”句，向官吏们坦露自己的心志。",
          "locator": "赏析二",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_3",
          "text": "首句到“日晏犹得眠”为第一部分……“忽然遭世变”到“此州独见全”为第二部分……“使臣将王命”到“以作时世贤”为第三部分……“思欲委符节”到尾句为第四部分",
          "locator": "赏析三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可按照四段的叙事逻辑逐层拆解内容，对比昔与今、贼与官的反差",
        "可指出前半段的太平叙事为后半段的愤激批判做铺垫"
      ],
      "forbidden_assertions": [
        "随意打乱诗歌的叙事顺序，将归隐段落放在征敛批判段落之前讲解",
        "否定昔与今、贼与官的对比是本诗的核心表达手法"
      ]
    },
    {
      "claim_id": "claim_04_fire_metaphor",
      "claim": "诗句“今彼征敛者，迫之如火煎”使用了比喻修辞，将官吏催逼赋税的状态比作用火煎烤，凸显百姓被逼到绝境的惨状。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_translation_2",
          "text": "现在那横征暴敛的官吏，催赋逼税恰如火烧油煎",
          "locator": "译文二",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "今彼征敛者，迫之如火煎，更活画出一幅虎狼官吏陷民于水火的真实情景",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可引申说明该比喻将抽象的生存压迫转化为极具画面感的感官体验",
        "可关联前文“日晏犹得眠”的太平状态形成强烈反差"
      ],
      "forbidden_assertions": [
        "将该句解读为诗人赞美官吏征税效率高",
        "否认该句使用了比喻修辞"
      ]
    },
    {
      "claim_id": "claim_05_author_position",
      "claim": "元结在诗中明确表明自己不愿靠残害百姓来换取“贤能官吏”的名声，宁可丢弃符节辞去官职，携家归隐江湖，也绝不执行残民的征敛命令。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "诗人对待这一矛盾的处境的办法是：宁愿弃官，归隐江湖，也绝不去做那种残民邀功、取媚于上的所谓贤臣",
          "locator": "赏析二",
          "authority": "high"
        },
        {
          "source_id": "source_translation_3",
          "text": "我想辞去官职丢弃符节，拿起竹篙自己动手撑船。带领全家回到鱼米之乡，告老归隐住在那江湖边",
          "locator": "译文三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可说明这一表态是元结仁政爱民思想的直接体现",
        "可关联元结“救时劝俗”的文学主张解读创作动机"
      ],
      "forbidden_assertions": [
        "声称元结的归隐表态只是故作姿态，没有实际行动支撑",
        "将“归老江湖边”解读为诗人对百姓疾苦完全漠不关心"
      ]
    },
    {
      "claim_id": "claim_06_lexical_definition",
      "claim": "诗中核心字词如“昔岁”指从前；“庭户”指庭院；“洞壑”指山洞、沟壑；“井税”借指唐代的赋税；“晏”指晚；“世变”指安史之乱所带来的社会动荡；“戎旃”指战旗或军帐，代指军事；“典”指治理、掌管；“山夷”指聚集山中的武装力量；“见全”指被保全；“将王命”指奉皇上的旨意；“委符节”指辞官；“引竿”代指隐居；“刺船”指撑船；“将”指带着；“就”指靠近。",
      "status": "documented",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "昔岁：从前。庭户：庭院。洞壑：山洞，沟壑。井税：田赋……此处借以指唐代的赋税。晏：晚。世变：指安史之乱所带来的社会动荡。戎旃：战旗。一说为军帐。典：治理、掌管。山夷：古代对聚集山中的武装力量的贬称。见全：被保全。将王命：奉皇上的旨意。委符节：指辞官。引竿：拿钓竿，代指隐居。刺船：撑船。将：带着。就：靠近。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_3",
          "text": "西原贼：又称“西原蛮”……“西原贼”是唐朝时对广西少数民族带有歧视和蔑视意味的称呼，类似“蛮夷戎狄”之说。戎旃（zhān）：军旗，代指军事。",
          "locator": "注释三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可结合古代井田制的背景讲解“井税”一词的词义来源",
        "可说明部分字词存在异文版本差异，不影响核心语义理解"
      ],
      "forbidden_assertions": [
        "将“井税”错误解读为井水的赋税",
        "将“戎旃”错误解读为普通百姓的帐篷"
      ]
    },
    {
      "claim_id": "claim_07_textual_variants",
      "claim": "本诗在不同版本中存在异文：l01中的“昔岁”在版本四中作“昔年”；l09中的“彼”在版本四中作“被”，注释中指出“彼”一作“被”；l12中的“湖”一作“海”。",
      "status": "documented",
      "importance": 1,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "昔岁：从前。岁，一作“年”。彼：一作“被”。湖：一作“海”。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_original_4",
          "text": "昔年逢太平……今被征敛者，迫之如火煎。",
          "locator": "原文版本四",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "异文的存在不影响诗歌整体的批判主题和艺术价值"
      ],
      "forbidden_assertions": [
        "断言只有某一个版本是绝对正确的，排斥其他异文的存在"
      ]
    },
    {
      "claim_id": "claim_08_contrast_method",
      "claim": "本诗运用了强烈的对比手法，包括“昔”之太平（井税有常期、日晏犹得眠）与“今”之乱世（迫之如火煎）的对比，以及“贼”之“伤怜”不屠与“官”之“横征暴敛”的对比，以此突出官吏的残暴。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_1",
          "text": "他把“诸使”和“贼”对比起来写，通过对“贼”的有所肯定，来衬托官吏的残暴",
          "locator": "赏析一",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "作者把人民没有额外负担看作是年岁太平的主要标志……便为后面揭露“今”时统治者肆意勒索人民设下了伏笔。……和前面“井税”两句相照应，与“昔”形成鲜明对比",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "对比手法的运用使诗歌的批判力度更加深沉、感情更加愤激"
      ],
      "forbidden_assertions": [
        "认为诗中对“昔”的描写与后文的批判毫无关联"
      ]
    }
  ],
