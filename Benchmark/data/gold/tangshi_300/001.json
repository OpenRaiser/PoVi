  "key_events": [
    {
      "event_id": "evt_001_01",
      "description": "安史之乱爆发前，元结曾在山林中隐居了约二十年，度过了一段井田赋税有常规、生活安稳平静的太平岁月。",
      "audio_triggers": [
        "昔岁逢太平",
        "山林二十年",
        "井税有常期"
      ],
      "visual_evidence": [
        "唐代早期服饰",
        "隐士山林",
        "清幽的庭院",
        "自然山水环境"
      ],
      "sound_evidence": [
        "清泉流水声",
        "自然鸟鸣",
        "静谧的氛围音"
      ],
      "importance": 1
    },
    {
      "event_id": "evt_001_02",
      "description": "随着安史之乱爆发，遭遇世道突变，元结离开山林，亲自参加平叛的军事行动长达数年。",
      "audio_triggers": [
        "忽然遭世变",
        "数岁亲戎旃",
        "从军"
      ],
      "visual_evidence": [
        "唐代军装战袍",
        "飘扬的战旗",
        "军营或行军景象"
      ],
      "sound_evidence": [
        "战马嘶鸣",
        "沉闷的战鼓声",
        "兵戈相交的音效"
      ],
      "importance": 2
    },
    {
      "event_id": "evt_001_03",
      "description": "通常认为在广德元年（763年，癸卯年），被称为“西原蛮”的武装力量攻入道州，大肆焚烧杀掠，导致城池遭到严重破坏。",
      "audio_triggers": [
        "西原贼",
        "癸卯岁",
        "入道州"
      ],
      "visual_evidence": [
        "残破的城郭",
        "燃烧的建筑",
        "逃难的平民",
        "武装劫掠场面"
      ],
      "sound_evidence": [
        "大火燃烧的噼啪声",
        "民众惊恐的哭喊声"
      ],
      "importance": 2
    },
    {
      "event_id": "evt_001_04",
      "description": "广德二年（764年），元结被朝廷任命为道州刺史，接手治理战后残破的道州郡。",
      "audio_triggers": [
        "今来典斯郡",
        "道州刺史",
        "上任"
      ],
      "visual_evidence": [
        "唐代刺史级别官服",
        "残破的州衙官署",
        "堆积的公文文书"
      ],
      "sound_evidence": [
        "沉重的叹息声",
        "翻阅简牍纸张的声音"
      ],
      "importance": 3
    },
    {
      "event_id": "evt_001_05",
      "description": "同年，“西原蛮”再次发难，攻破相邻的永州和邵州。道州因城小人贫，出于同情未被再次侵犯而独得保全。",
      "audio_triggers": [
        "山夷又纷然",
        "城小贼不屠",
        "人贫伤可怜",
        "独见全"
      ],
      "visual_evidence": [
        "远方邻县的烽火战乱",
        "道州百姓贫苦无依的面貌",
        "贼寇大军过境但不入城"
      ],
      "sound_evidence": [
        "远处的兵马响动",
        "逐渐远去的行军声"
      ],
      "importance": 2
    },
    {
      "event_id": "evt_001_06",
      "description": "相比盗贼的退避，朝廷派出的催收租庸赋税的使臣却不顾百姓死活，奉命来到道州横征暴敛，逼税如火煎。",
      "audio_triggers": [
        "使臣将王命",
        "征敛者",
        "迫之如火煎"
      ],
      "visual_evidence": [
        "唐代使臣服饰",
        "官吏严酷呵斥的表情",
        "跪地哀求的贫苦百姓",
        "被迫上缴的粮食财物"
      ],
      "sound_evidence": [
        "官吏厉声呵斥",
        "百姓凄厉的哭诉声",
        "打砸抢夺的声音"
      ],
      "importance": 3
    },
    {
      "event_id": "evt_001_07",
      "description": "元结对官吏残民邀功的行为极度愤慨，深感宁可弃官归隐江湖，也不愿断绝百姓生路去作“时世贤”，由此写成《贼退示官吏》警示同僚。",
      "audio_triggers": [
        "谁能绝人命",
        "思欲委符节",
        "归老江湖边",
        "作诗"
      ],
      "visual_evidence": [
        "元结在书案前愤怒地奋笔疾书",
        "手旁的刺史符节",
        "决绝而悲悯的神情",
        "隐现的一叶扁舟画面"
      ],
      "sound_evidence": [
        "毛笔在纸张上的疾书声",
        "悲壮苍凉的背景乐"
      ],
      "importance": 3
    }
  ],
