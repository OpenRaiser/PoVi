      "term": "添酒回灯重开宴。",
      "pronunciation": "tiān jiǔ huí dēng chóng kāi yàn。",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "千呼万唤始出来，",
      "pronunciation": "qiān hū wàn huàn shǐ chū lái,",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "犹抱琵琶半遮面。",
      "pronunciation": "yóu bào pí pá bàn zhē miàn。",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "转轴拨弦三两声，",
      "pronunciation": "zhuǎn zhóu bō xián sān liǎng shēng,",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "未成曲调先有情。",
      "pronunciation": "wèi chéng qǔ diào xiān yǒu qíng。",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "弦弦掩抑声声思，",
      "pronunciation": "xián xián yǎn yì shēng shēng sì,",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "似诉平生不得志。",
      "pronunciation": "sì sù píng shēng bù dé zhì。",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "低眉信手续续弹，",
      "pronunciation": "dī méi xìn shǒu xù xù tán,",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "说尽心中无限事。",
      "pronunciation": "shuō jìn xīn zhōng wú xiàn shì。",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "轻拢慢捻抹复挑，",
      "pronunciation": "qīng lǒng màn niǎn mǒ fù tiǎo,",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "浔阳江",
      "pronunciation": "xún yáng jiāng",
      "category": "place",
      "importance": 2
    },
    {
      "term": "思",
      "pronunciation": "sì",
      "accepted_variants": [
        "sī"
      ],
      "category": "polyphone",
      "importance": 2
    },
    {
      "term": "挑",
      "pronunciation": "tiǎo",
      "accepted_variants": [
        "tiāo"
      ],
      "category": "polyphone",
      "importance": 2
    },
    {
      "term": "重",
      "pronunciation": "chóng",
      "accepted_variants": [
        "zhòng"
      ],
      "category": "polyphone",
      "importance": 2
    },
    {
      "term": "调",
      "pronunciation": "diào",
      "accepted_variants": [
        "tiáo"
      ],
      "category": "polyphone",
      "importance": 2
    },
    {
      "term": "初为霓裳后六幺。",
      "pronunciation": "chū wéi ní cháng hòu lù yāo",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "大弦嘈嘈如急雨，",
      "pronunciation": "dà xián cáo cáo rú jí yǔ",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "小弦切切如私语。",
      "pronunciation": "xiǎo xián qiè qiè rú sī yǔ",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "嘈嘈切切错杂弹，",
      "pronunciation": "cáo cáo qiè qiè cuò zá tán",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "大珠小珠落玉盘。",
      "pronunciation": "dà zhū xiǎo zhū luò yù pán",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "间关莺语花底滑，",
      "pronunciation": "jiān guān yīng yǔ huā dǐ huá",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "幽咽泉流冰下滩。",
      "pronunciation": "yōu yè quán liú bīng xià tān",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "冰泉冷涩弦凝绝，",
      "pronunciation": "bīng quán lěng sè xián níng jué",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "凝绝不通声渐歇。",
      "pronunciation": "níng jué bù tōng shēng jiàn xiē",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "别有幽愁暗恨生，",
      "pronunciation": "bié yǒu yōu chóu àn hèn shēng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "此时无声胜有声。",
      "pronunciation": "cǐ shí wú shēng shèng yǒu shēng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "银瓶乍破水浆迸，",
      "pronunciation": "yín píng zhà pò shuǐ jiāng bèng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "铁骑突出刀枪鸣。",
      "pronunciation": "tiě jì tū chū dāo qiāng míng",
      "accepted_variants": [
        "tiě qí tū chū dāo qiāng míng"
      ],
      "category": "poem",
      "importance": 3
    },
    {
      "term": "曲终收拨当心画，",
      "pronunciation": "qǔ zhōng shōu bō dāng xīn huà",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "四弦一声如裂帛。",
      "pronunciation": "sì xián yī shēng rú liè bó",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "东船西舫悄无言，",
      "pronunciation": "dōng chuán xī fǎng qiǎo wú yán",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "唯见江心秋月白。",
      "pronunciation": "wéi jiàn jiāng xīn qiū yuè bái",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "沉吟放拨插弦中，",
      "pronunciation": "chén yín fàng bō chā xián zhōng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "整顿衣裳起敛容。",
      "pronunciation": "zhěng dùn yī cháng qǐ liǎn róng",
      "accepted_variants": [
        "zhěng dùn yī shang qǐ liǎn róng"
      ],
      "category": "poem",
      "importance": 3
    },
    {
      "term": "自言本是京城女，",
      "pronunciation": "zì yán běn shì jīng chéng nǚ",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "家在虾蟆陵下住。",
      "pronunciation": "jiā zài há ma líng xià zhù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "十三学得琵琶成，",
      "pronunciation": "shí sān xué dé pí pá chéng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "名属教坊第一部。",
      "pronunciation": "míng shǔ jiào fāng dì yī bù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "曲罢常教善才伏，",
      "pronunciation": "qǔ bà cháng jiào shàn cái fú",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "霓裳",
      "pronunciation": "ní cháng",
      "category": "allusion",
      "importance": 2
    },
    {
      "term": "六幺",
      "pronunciation": "lù yāo",
      "accepted_variants": [
        "liù yāo"
      ],
      "category": "allusion",
      "importance": 2
    },
    {
      "term": "间关",
      "pronunciation": "jiān guān",
