    {
      "term": "妆成每被秋娘妒。",
      "pronunciation": "zhuāng chéng měi bèi qiū niáng dù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "五陵年少争缠头，",
      "pronunciation": "wǔ líng nián shào zhēng chán tóu",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "一曲红绡不知数。",
      "pronunciation": "yī qǔ hóng xiāo bù zhī shù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "钿头云篦击节碎，",
      "pronunciation": "diàn tóu yún bì jī jié suì",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "血色罗裙翻酒污。",
      "pronunciation": "xuè sè luó qún fān jiǔ wū",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "今年欢笑复明年，",
      "pronunciation": "jīn nián huān xiào fù míng nián",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "秋月春风等闲度。",
      "pronunciation": "qiū yuè chūn fēng děng xián dù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "弟走从军阿姨死，",
      "pronunciation": "dì zǒu cóng jūn ā yí sǐ",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "暮去朝来颜色故。",
      "pronunciation": "mù qù zhāo lái yán sè gù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "门前冷落车马稀，",
      "pronunciation": "mén qián lěng luò chē mǎ xī",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "老大嫁作商人妇。",
      "pronunciation": "lǎo dà jià zuò shāng rén fù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "商人重利轻别离，",
      "pronunciation": "shāng rén zhòng lì qīng bié lí",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "前月浮梁买茶去。",
      "pronunciation": "qián yuè fú liáng mǎi chá qù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "去来江口守空船，",
      "pronunciation": "qù lái jiāng kǒu shǒu kōng chuán",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "绕船明月江水寒。",
      "pronunciation": "rào chuán míng yuè jiāng shuǐ hán",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "夜深忽梦少年事，",
      "pronunciation": "yè shēn hū mèng shào nián shì",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "梦啼妆泪红阑干。",
      "pronunciation": "mèng tí zhuāng lèi hóng lán gān",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "我闻琵琶已叹息，",
      "pronunciation": "wǒ wén pí pá yǐ tàn xī",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "又闻此语重唧唧。",
      "pronunciation": "yòu wén cǐ yǔ chóng jī jī",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "同是天涯沦落人，",
      "pronunciation": "tóng shì tiān yá lún luò rén",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "相逢何必曾相识。",
      "pronunciation": "xiāng féng hé bì céng xiāng shí",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "我从去年辞帝京，",
      "pronunciation": "wǒ cóng qù nián cí dì jīng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "谪居卧病浔阳城。",
      "pronunciation": "zhé jū wò bìng xún yáng chéng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "浔阳地僻无音乐，",
      "pronunciation": "xún yáng dì pì wú yīn yuè",
      "category": "poem",
      "importance": 3
    },
    {
