          "authority": "high"
        },
        {
          "source_id": "source_original_3",
          "text": "并序部分标注凡六百一十二言，“幽咽泉流冰下滩”“钿头云篦击节碎”“门前冷落车马稀”",
          "locator": "原文版本三",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
