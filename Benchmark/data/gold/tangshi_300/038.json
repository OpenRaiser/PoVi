    {
      "term": "浔阳",
      "pronunciation": "xún yáng",
      "category": "place",
      "importance": 2
    },
    {
      "term": "终岁不闻丝竹声。",
      "pronunciation": "zhōng suì bù wén sī zhú shēng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "住近湓江地低湿，",
      "pronunciation": "zhù jìn pén jiāng dì dī shī",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "黄芦苦竹绕宅生。",
      "pronunciation": "huáng lú kǔ zhú rào zhái shēng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "其间旦暮闻何物，",
      "pronunciation": "qí jiān dàn mù wén hé wù",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "杜鹃啼血猿哀鸣。",
      "pronunciation": "dù juān tí xuè yuán āi míng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "春江花朝秋月夜，",
      "pronunciation": "chūn jiāng huā zhāo qiū yuè yè",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "往往取酒还独倾。",
      "pronunciation": "wǎng wǎng qǔ jiǔ hái dú qīng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "岂无山歌与村笛，",
      "pronunciation": "qǐ wú shān gē yǔ cūn dí",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "呕哑嘲哳难为听。",
      "pronunciation": "ōu yā zhāo zhā nán wéi tīng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "今夜闻君琵琶语，",
      "pronunciation": "jīn yè wén jūn pí pá yǔ",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "如听仙乐耳暂明。",
      "pronunciation": "rú tīng xiān yuè ěr zàn míng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "莫辞更坐弹一曲，",
      "pronunciation": "mò cí gèng zuò tán yī qǔ",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "为君翻作琵琶行。",
      "pronunciation": "wèi jūn fān zuò pí pá xíng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "感我此言良久立，",
      "pronunciation": "gǎn wǒ cǐ yán liáng jiǔ lì",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "却坐促弦弦转急。",
      "pronunciation": "què zuò cù xián xián zhuǎn jí",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "凄凄不似向前声，",
      "pronunciation": "qī qī bù sì xiàng qián shēng",
      "category": "poem",
      "importance": 3
    },
    {
      "term": "满座重闻皆掩泣。",
      "pronunciation": "mǎn zuò chóng wén jiē yǎn qì",
      "category": "poem",
      "importance": 3
    },
    {
