      ],
      "importance": 2
    },
    {
      "metaphor_id": "meta_03_li_general_paradigm",
      "line_ids": [
        "l14"
      ],
      "source_domain": [
        "汉代名将李广爱护士卒、威慑匈奴的经典事迹形象"
      ],
      "target_domain": [
        "诗人理想中体恤士卒、骁勇善战的优秀边塞将领范式"
      ],
      "bridges": [
        "李广的史实形象和诗中骄奢轻敌的主将形成鲜明反差，承载了作者对理想边将的全部期待"
      ],
      "status": "consensus",
      "context_claim_ids": [
        "claim_04_li_general_reference"
      ],
      "alternative_readings": [
