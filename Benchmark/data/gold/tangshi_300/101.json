{
  "schema_version": "0.2",
  "sample_id": "tangshi_300_101",
  "gold_status": "adjudicated_gold",
  "evidence_claims": [
    {
      "claim_id": "claim_01_identity",
      "claim": "《燕歌行》是唐代边塞诗人高适创作的乐府旧题边塞诗，属于高适的代表作，也是盛唐边塞诗的经典作品。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "poem",
          "text": "诗歌元数据明确标注题名为燕歌行，作者高适，朝代唐，体裁乐府。",
          "locator": "poem",
          "authority": "high"
        },
        {
          "source_id": "source_author_bio_1",
          "text": "高适是唐代著名边塞诗人，代表作包含《燕歌行》。",
          "locator": "作者简介一",
          "authority": "medium"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "《燕歌行》是高适的第一大篇，也是整个唐代边塞诗中的杰作。",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可将该作品归入盛唐边塞诗派核心代表作范畴"
      ],
      "forbidden_assertions": [
        "将该作品误认为是曹丕所作的同题闺怨诗",
        "将该作品归为普通男女相思题材"
      ]
    },
    {
      "claim_id": "claim_02_creation_background",
      "claim": "该诗作于开元二十六年，高适因有感于东北边塞多次战败、军中苦乐不均的现实而作，创作缘起是应和一位从塞外归来的友人所作的同题作品。",
      "status": "documented",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_original_2",
          "text": "开元二十六年，客有从元戎出塞而还者，作《燕歌行》以示，适感征戍之事，因而和焉。",
          "locator": "原文版本二",
          "authority": "high"
        },
        {
          "source_id": "source_background_2",
          "text": "《燕歌行》此诗作于开元二十六年（738年），高适35岁漫游燕赵时，序言明示为感戍边将领张守珪军中事而作，实糅合诗人多年边塞见闻。",
          "locator": "创作背景二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "高适本人有长期东北边塞游历经历，对军中实际情况十分了解，创作有现实基础"
      ],
      "forbidden_assertions": [
        "声称这首诗是高适完全脱离现实凭空虚构的作品"
      ]
    },
    {
      "claim_id": "claim_03_irony_contrast",
      "claim": "“战士军前半死生，美人帐下犹歌舞”两句运用强烈对比，揭露了军中主将荒淫失职、不恤士卒的现实，是全诗最具批判性的名句。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_appreciation_4",
          "text": "“战士军前半死生，美人帐下犹歌舞”二句最为沉至，诗既赞战士为国奋战，又讥将领之贪恋歌舞。",
          "locator": "赏析四",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "“战士”两句用对比方法写出了主将骄惰轻敌，不恤士卒，一面是拚死苦战，一面仍恣意逸乐，这是诗中最有揭露性的描写。",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可引申说明盛唐边塞军中存在的阶级苦乐不均的现实矛盾"
      ],
      "forbidden_assertions": [
        "将这两句解读为描写军民同乐的和谐场景"
      ]
    },
    {
      "claim_id": "claim_04_li_general_reference",
      "claim": "诗末“至今犹忆李将军”中的李将军指代汉代名将李广，他以爱护士卒、骁勇善战著称，诗人借此表达对体恤士兵的良将的向往。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1",
          "text": "李将军：指李广。善用兵，爱惜士卒，守右北平，匈奴畏之不敢南侵，称为飞将军。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2",
          "text": "李将军：指汉朝李广，他能捍御强敌，爱抚士卒，匈奴称他为汉之飞将军。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "可以对比李广和诗中失职主将的形象差异，凸显作者的批判立场"
      ],
      "forbidden_assertions": [
        "将此处李将军误认为是唐代的其他名将"
      ]
    },
    {
      "claim_id": "claim_05_parallel_narrative",
      "claim": "全诗“铁衣远戍辛勤久”到“寒声一夜传刁斗”段落采用征人、思妇双线并行的叙事结构，同时描写前线士兵和后方家属的两地相思之苦。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_3",
          "text": "第三段八句对举征人、思妇两地相隔，两处相思的情景，突出双方思念而不知何时再见的愁绪。",
          "locator": "赏析三",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2",
          "text": "第三段八句写征人，思妇两地相望，重会无期。",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "这种双线结构强化了战争给普通民众带来的全方位苦难"
      ],
      "forbidden_assertions": [
        "声称这段内容只描写了前线士兵的思乡情绪"
      ]
    },
    {
      "claim_id": "claim_06_ironic_target_dispute",
      "claim": "关于本诗具体讽刺的军中主将身份，历来存在争议，部分注家认为是讽刺张守珪，也有观点认为讽刺的是安禄山等其他将领，不能简单将其坐实为某一个人。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_appreciation_2",
          "text": "历来注家未对序文史事详加考核，都以为是讽张守珪而作。其实，这是不符史实的。此诗所刺对象应是受张守珪派遣、前往征讨奚、契丹的平卢讨击使、左骁卫将军安禄山。",
          "locator": "赏析二",
          "authority": "high"
        },
        {
          "source_id": "source_background_1",
          "text": "历来注家都以为是讽张守珪而作，但也有不少人认为所讽对象是安禄山、赵堪与白真陁罗等人，此诗并非仅限定于写张守珪之事。",
          "locator": "创作背景一",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "教学中可以说明该诗的批判是针对普遍的军中骄奢轻敌现象而非单一特定人物"
      ],
      "forbidden_assertions": [
        "绝对断言本诗唯一的讽刺对象就是张守珪"
      ]
    },
    {
      "claim_id": "claim_07_lexical_hanjia",
      "claim": "“汉家”在诗中借指唐朝，唐代诗歌中经常采用“借汉说唐”的修辞手法。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1_hanjia",
          "text": "汉家：借指唐朝。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2_hanjia",
          "text": "汉家：汉朝，唐人诗中经常借汉说唐。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "诗中的“汉将”同样借指唐朝的将领"
      ],
      "forbidden_assertions": [
        "认为这首诗描写的是汉代的历史事件而非唐代时事"
      ]
    },
    {
      "claim_id": "claim_08_lexical_yuguan",
      "claim": "“榆关”指山海关，是通往东北的军事要隘。",
      "status": "consensus",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1_yuguan",
          "text": "榆关：山海关。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2_yuguan",
          "text": "榆关：山海关，通往东北的要隘。",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "“下榆关”意指军队开赴山海关外的东北战场"
      ],
      "forbidden_assertions": [
        "将榆关解释为玉门关或阳关等西北关隘"
      ]
    },
    {
      "claim_id": "claim_09_alternative_reading_blood",
      "claim": "“相看白刃血纷纷”中的“血”字存在异文，在其他版本中亦作“雪”或“徒”。",
      "status": "disputed",
      "importance": 2,
      "evidence": [
        {
          "source_id": "source_notes_1_blood",
          "text": "血纷纷：一作「雪纷纷」、一作「徒纷纷」。",
          "locator": "注释一",
          "authority": "high"
        },
        {
          "source_id": "source_notes_2_blood",
          "text": "血：一作“雪”",
          "locator": "注释二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "若作“雪纷纷”，则可与前文“大漠穷秋”的寒冷气候相呼应，形容刀光如雪或大雪纷飞中厮杀"
      ],
      "forbidden_assertions": [
        "断定“血纷纷”是唯一的历史记载版本"
      ]
    },
    {
      "claim_id": "claim_10_genre_history",
      "claim": "《燕歌行》是乐府旧题，属于《相和歌》中的《平调曲》，曹丕首创此调写妇女秋思，而高适是第一个用此调写将士边塞生活的诗人。",
      "status": "consensus",
      "importance": 3,
      "evidence": [
        {
          "source_id": "source_notes_3_genre",
          "text": "燕歌行：乐府旧题。自曹丕的《燕歌行》首创以妇女秋思入题始，后人多学他用此曲调写作闺怨诗。",
          "locator": "注释三",
          "authority": "high"
        },
        {
          "source_id": "source_appreciation_2_genre",
          "text": "《燕歌行》是一个乐府题目，属于《相和歌》中的《平调曲》……曹丕的《燕歌行》有两首，是写妇女秋思，由他首创……高适的《燕歌行》是写将士生活，用燕歌行曲调写此题材他是第一个。",
          "locator": "赏析二",
          "authority": "high"
        }
      ],
      "acceptable_inferences": [
        "高适此作既继承了乐府旧题的音调，又在题材上进行了极具开创性的拓展"
      ],
      "forbidden_assertions": [
        "认为高适是《燕歌行》这一乐府曲调的音乐首创者"
      ]
    }
  ],
