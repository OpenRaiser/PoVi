      ],
      "target_domain": [
        "边境发生的战争、战事警报"
      ],
      "bridges": [
        "古代边境有战事时会点燃烽烟报警，战场之上必然尘土飞扬，二者是战争发生的典型伴随意象"
      ],
      "status": "consensus",
      "context_claim_ids": [
