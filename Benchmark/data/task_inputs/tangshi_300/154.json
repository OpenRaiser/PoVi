  "poem": {
    "title": "过故人庄",
    "author": "孟浩然",
    "dynasty": "唐",
    "form": "五言律诗",
    "text": "故人具鸡黍，邀我至田家。\n绿树村边合，青山郭外斜。\n开轩面场圃，把酒话桑麻。\n待到重阳日，还来就菊花。",
