  "poem": {
    "title": "渔翁",
    "author": "柳宗元",
    "dynasty": "唐",
    "form": "七言古诗",
    "text": "渔翁夜傍西岩宿，晓汲清湘燃楚竹。\n烟销日出不见人，欸乃一声山水绿。\n回看天际下中流，岩上无心云相逐。",
    "lines": [
