  "poem": {
    "title": "鹧鸪天",
    "author": "晏几道",
    "dynasty": "宋",
    "form": "词",
    "text": "彩袖殷勤捧玉钟，当年拚却醉颜红。\n舞低杨柳楼心月，歌尽桃花扇底风。\n从别后，忆相逢，几回魂梦与君同。\n今宵剩把银釭照，犹恐相逢是梦中。",
    "lines": [
