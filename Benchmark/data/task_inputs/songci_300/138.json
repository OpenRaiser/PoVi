  "poem": {
    "title": "临江仙",
    "author": "陈与义",
    "dynasty": "宋",
    "form": "词",
    "text": "高咏《楚词》酬午日，天涯节序匆匆。\n榴花不似舞裙红，无人知此意，歌罢满帘风。\n万事一身伤老矣，戎葵凝笑墙东。\n酒杯深浅去年同，试浇桥下水，今夕到湘中。",
    "lines": [
