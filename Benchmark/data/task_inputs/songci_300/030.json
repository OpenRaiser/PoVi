  "poem": {
    "title": "浪淘沙",
    "author": "欧阳修",
    "dynasty": "宋",
    "form": "词",
    "text": "把酒祝东风，且共从容。\n垂杨紫陌洛城东，总是当时携手处，游遍芳丛。\n聚散苦匆匆，此恨无穷。\n今年花胜去年红，可惜明年花更好，知与谁同？",
    "lines": [
