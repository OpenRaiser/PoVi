# Copy this file to .env and fill only the services you plan to use.

# Text-judging API
TEXT_JUDGE_API_KEY=
TEXT_JUDGE_BASE_URL=https://api.deepseek.com
TEXT_JUDGE_MODEL=deepseek-v4-pro
# Bounds reasoning length for reasoning models (low/medium/high/none); default low
TEXT_JUDGE_REASONING_EFFORT=low

# Optional fallback text-judging API
TEXT_JUDGE_FALLBACK_API_KEY=
TEXT_JUDGE_FALLBACK_BASE_URL=
TEXT_JUDGE_FALLBACK_MODEL=

# Speech-transcription API
SPEECH_TRANSCRIPTION_API_KEY=
SPEECH_TRANSCRIPTION_BASE_URL=https://api.siliconflow.cn/v1
SPEECH_TRANSCRIPTION_MODEL=TeleAI/TeleSpeechASR

# Multimodal-judging API
MULTIMODAL_JUDGE_API_KEY=
MULTIMODAL_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
MULTIMODAL_JUDGE_MODEL=Qwen/Qwen3.5-397B-A17B

# Optional compatibility fallbacks for the text-judging API.
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
